---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts  = await getCollection('posts');
const posts     = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pick      = posts[0];          // Editor's Pick
const bento     = posts.slice(1, 7); // Bento grid (up to 6)

// Reading time helper
const readMin = (body: string) => Math.max(1, Math.ceil(body.split(/\s+/).length / 200));

// Category slug → CSS class
const catClass = (cat: string) => cat.toLowerCase().split(' ')[0];

const categories = [
  {
    slug:     'travel-kids',
    label:    'Travel & Kids',
    num:      '01',
    cls:      'travel',
    headline: '여행과 <em>아이</em>, 그리고 <em>속도</em>에 대하여',
  },
  {
    slug:     'life-policy',
    label:    'Life & Policy',
    num:      '02',
    cls:      'life',
    headline: '받을 수 있는 <em>것들</em>, 그리고 <em>지나친</em> 것들에 대하여',
  },
  {
    slug:     'tech-gear',
    label:    'Tech & Gear',
    num:      '03',
    cls:      'tech',
    headline: '오래 <em>고민</em>하고, 오래 <em>쓰는</em> 것들에 대하여',
  },
  {
    slug:     'dev-quant',
    label:    'Dev & Quant',
    num:      '04',
    cls:      'dev',
    headline: '<em>만들어</em>보고, <em>굴려</em>보는 것들에 대하여',
  },
];
---

<Layout title="다다노트">
<style>
/* ── Hero ─────────────────────────────────────────── */
.hero {
  padding: 96px 56px 80px;
  max-width: 1280px; margin: 0 auto; width: 100%;
}
.hero-eyebrow {
  font-family: var(--mono); font-size: 11px; letter-spacing: .2em;
  text-transform: uppercase; color: var(--muted); margin-bottom: 28px;
  display: flex; align-items: center; gap: 14px;
}
.hero-eyebrow::before { content: ""; width: 32px; height: 1px; background: var(--muted); }
.hero-headline {
  font-family: var(--serif); font-weight: 300;
  font-size: clamp(44px, 5.5vw, 84px);
  line-height: 1.12; letter-spacing: -.025em;
  color: var(--ink); max-width: 820px; margin-bottom: 28px;
  text-wrap: balance;
}
.hero-headline em { font-style: italic; color: var(--ink-2); }
.hero-sub {
  font-family: var(--serif); font-size: clamp(16px, 1.4vw, 20px);
  color: var(--ink-2); font-weight: 300; line-height: 1.7;
  max-width: 560px; margin-bottom: 40px;
}
.hero-cats { display: flex; gap: 10px; flex-wrap: wrap; }
.hero-cat-pill {
  padding: 7px 16px; border: 1px solid var(--line); border-radius: 100px;
  font-size: 12px; font-weight: 500; color: var(--ink-2);
  background: var(--bg-elev);
  transition: border-color .25s, color .25s, transform .25s var(--ease-out);
}
.hero-cat-pill:hover { border-color: var(--ink); color: var(--ink); transform: translateY(-2px); }

/* ── Editor's Pick ─────────────────────────────────── */
.pick-wrap { max-width: 1280px; margin: 0 auto; padding: 0 56px 80px; }
.pick-card {
  display: grid; grid-template-columns: 1fr 1fr;
  border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
  background: var(--bg-elev); min-height: 480px;
  transition: box-shadow .4s;
}
.pick-card:hover { box-shadow: 0 20px 60px oklch(0.15 0.01 85 / .09); }
.pick-img { overflow: hidden; background: oklch(0.93 0.02 80); }
.pick-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease-out); }
.pick-card:hover .pick-img img { transform: scale(1.03); }
.pick-body { padding: 52px 48px; display: flex; flex-direction: column; justify-content: space-between; }
.pick-tag { font-family: var(--mono); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); margin-bottom: 18px; }
.pick-title {
  font-family: var(--serif); font-weight: 300;
  font-size: clamp(22px, 2.2vw, 34px); line-height: 1.25;
  letter-spacing: -.02em; margin: 14px 0 20px; text-wrap: pretty;
}
.pick-dek { font-family: var(--serif); font-size: 16px; line-height: 1.7; color: var(--ink-2); font-weight: 300; flex-grow: 1; }
.pick-foot { display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--muted); margin-top: 36px; }
.pick-cta {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 13px; font-weight: 500; color: var(--ink);
  border-bottom: 1px solid var(--line-s); padding-bottom: 3px;
  margin-top: 20px; transition: border-color .2s;
}
.pick-cta:hover { border-color: var(--ink); }

/* ── Bento grid ────────────────────────────────────── */
.bento-wrap { max-width: 1280px; margin: 0 auto; padding: 0 56px 80px; }
.bento-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-template-rows: 280px 280px;
  gap: 16px;
}
.bento-card {
  grid-column: span 4; /* default fallback */
  border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
  background: var(--bg-elev); display: flex; flex-direction: column;
  transition: transform .35s var(--ease-out), box-shadow .35s;
}
.bento-card:nth-child(1) { grid-column: span 5; }
.bento-card:nth-child(2) { grid-column: span 4; }
.bento-card:nth-child(3) { grid-column: span 3; }
.bento-card:nth-child(4) { grid-column: span 3; }
.bento-card:nth-child(5) { grid-column: span 5; }
.bento-card:nth-child(6) { grid-column: span 4; }
.bento-card:hover { transform: translateY(-4px); box-shadow: 0 16px 48px oklch(0.15 0.01 85 / .09); }
.bento-thumb { flex: 0 0 54%; overflow: hidden; background: oklch(0.93 0.015 85); }
.bento-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease-out); }
.bento-card:hover .bento-thumb img { transform: scale(1.05); }
.bento-body { padding: 18px 22px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
.bento-title { font-family: var(--serif); font-size: 15px; font-weight: 400; line-height: 1.4; letter-spacing: -.01em; text-wrap: pretty; }
.bento-date { font-size: 11px; color: var(--muted); margin-top: auto; }
.bento-more { display: flex; justify-content: flex-end; padding-bottom: 24px; }
.bento-more a { font-size: 13px; font-weight: 500; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; transition: color .2s; }
.bento-more a:hover { color: var(--ink); }

/* ── Category directory ─────────────────────────────── */
.catdir-wrap { max-width: 1280px; margin: 0 auto; padding: 0 56px 96px; }
.catdir-row {
  display: grid; grid-template-columns: 72px 1fr auto;
  align-items: center; gap: 32px; padding: 28px 0;
  border-bottom: 1px solid var(--line); transition: padding-left .3s var(--ease-out);
}
.catdir-row:first-child { border-top: 1px solid var(--line); }
.catdir-row:hover { padding-left: 8px; }
.catdir-row:hover .catdir-arr { transform: translateX(8px); }
.catdir-num { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 32px; color: var(--muted); }
.catdir-body { display: flex; flex-direction: column; gap: 6px; }
.catdir-title { font-family: var(--serif); font-weight: 300; font-size: 26px; letter-spacing: -.015em; text-wrap: balance; }
.catdir-title em { font-style: italic; color: var(--ink-2); }
.catdir-arr { font-size: 20px; color: var(--muted); transition: transform .35s var(--ease-out), color .2s; }
.catdir-row:hover .catdir-arr { color: var(--ink); }

/* ── Responsive ─────────────────────────────────────── */
@media (max-width: 768px) {
  .hero, .pick-wrap, .bento-wrap, .catdir-wrap { padding-left: 20px; padding-right: 20px; }
  .hero { padding-top: 56px; padding-bottom: 48px; }
  .pick-card { grid-template-columns: 1fr; }
  .pick-img { min-height: 220px; }
  .pick-body { padding: 32px 24px; }
  .bento-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
  .bento-card:nth-child(n) { grid-column: span 1; }
  .bento-grid { grid-template-rows: none; }
  .catdir-row { grid-template-columns: 40px 1fr auto; gap: 16px; padding: 20px 0; }
  .catdir-num { font-size: 22px; }
  .catdir-title { font-size: 18px; }
}
</style>

<!-- Hero -->
<section class="hero">
  <p class="hero-eyebrow reveal">다다노트 — 가족의 기록</p>
  <h1 class="hero-headline reveal" style="transition-delay:.06s">
    우리 가족의 이야기를,<br><em>솔직하게 기록합니다</em>
  </h1>
  <p class="hero-sub reveal" style="transition-delay:.1s">
    가족 여행의 현실, 직접 신청해본 정책,<br>
    써본 장비, 비전공자 아빠의 코딩 실험.
  </p>
  <div class="hero-cats reveal" style="transition-delay:.14s">
    {categories.map(c => (
      <a href={`/${c.slug}`} class="hero-cat-pill">{c.label}</a>
    ))}
  </div>
</section>

<!-- Editor's Pick -->
{pick && (
  <section class="pick-wrap">
    <div class="section-head reveal">Editor's Pick</div>
    <a href={`/posts/${pick.id}`} class="pick-card reveal">
      <div class="pick-img">
        {pick.data.image
          ? <img src={pick.data.image} alt={pick.data.title} loading="lazy" />
          : <div style="width:100%;height:100%;background:oklch(0.93 0.02 80)"></div>
        }
      </div>
      <div class="pick-body">
        <div>
          <p class="pick-tag">★ Editor's Pick</p>
          <span class={`cat ${catClass(pick.data.category)}`}>
            <span class="dot"></span>{pick.data.category}
          </span>
          <h2 class="pick-title">{pick.data.title}</h2>
          <p class="pick-dek">{pick.data.summary}</p>
        </div>
        <div>
          <div class="pick-foot">
            <time datetime={pick.data.date.toISOString()}>
              {pick.data.date.toLocaleDateString('ko-KR', {year:'numeric',month:'long',day:'numeric'})}
            </time>
            <span>·</span>
            <span>{readMin(pick.body)}분 분량</span>
          </div>
          <p class="pick-cta">전문 읽기 →</p>
        </div>
      </div>
    </a>
  </section>
)}

<!-- Bento grid -->
{bento.length > 0 && (
  <section class="bento-wrap">
    <div class="section-head reveal">최근 게시물</div>
    <div class="bento-grid">
      {bento.map((post, i) => (
        <a href={`/posts/${post.id}`}
           class="bento-card reveal"
           style={`transition-delay:${(i * 0.05).toFixed(2)}s`}>
          <div class="bento-thumb">
            {post.data.image
              ? <img src={post.data.image} alt={post.data.title} loading="lazy" />
              : <div style="width:100%;height:100%;background:oklch(0.93 0.015 85)"></div>
            }
          </div>
          <div class="bento-body">
            <span class={`cat ${catClass(post.data.category)}`}>
              <span class="dot"></span>{post.data.category}
            </span>
            <h3 class="bento-title">{post.data.title}</h3>
            <time class="bento-date">
              {post.data.date.toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric'})}
            </time>
          </div>
        </a>
      ))}
    </div>
    <div class="bento-more">
      <a href="/posts">남은 기록 전체 보기 →</a>
    </div>
  </section>
)}

<!-- Category directory -->
<section class="catdir-wrap">
  <div class="section-head reveal">카테고리</div>
  {categories.map((c, i) => (
    <a href={`/${c.slug}`}
       class="catdir-row reveal"
       style={`transition-delay:${(i * 0.07).toFixed(2)}s`}>
      <span class="catdir-num">{c.num}</span>
      <div class="catdir-body">
        <span class={`cat ${c.cls}`}><span class="dot"></span>{c.label}</span>
        <h3 class="catdir-title" set:html={c.headline}></h3>
      </div>
      <span class="catdir-arr">→</span>
    </a>
  ))}
</section>

</Layout>
