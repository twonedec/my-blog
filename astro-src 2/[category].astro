---
// src/pages/[category].astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const catMap: Record<string, { label: string; cls: string; headline: string; desc: string }> = {
    'travel-kids': {
      label:    'Travel & Kids',
      cls:      'travel',
      headline: '여행과 <em>아이</em>,<br>그리고 <em>속도</em>에 대하여',
      desc:     '온 가족이 함께한 장기여행과, 아이가 처음으로 본 풍경들. 빡빡한 일정 대신 같은 장소를 반복해서 찾는 우리만의 여행 방식을 기록합니다.',
    },
    'life-policy': {
      label:    'Life & Policy',
      cls:      'life',
      headline: '받을 수 있는 <em>것들</em>,<br>그리고 몰라서 <em>지나친</em> 것들에 대하여',
      desc:     '육아기 단축근무를 신청하면서 처음으로 제도를 제대로 들여다봤습니다. 알고 나면 간단한데, 모르면 그냥 넘어가게 되는 것들. 정책과 지원금, 절세와 보험을 직접 신청해보며 정리합니다.',
    },
    'tech-gear': {
      label:    'Tech & Gear',
      cls:      'tech',
      headline: '오래 <em>고민</em>하고,<br>오래 <em>쓰는</em> 것들에 대하여',
      desc:     '충동구매보다는 비교가 먼저입니다. 아이를 찍기 위해 카메라를 골랐고, 집에서 음악을 듣기 위해 턴테이블을 들였습니다. 사기 전에 고민한 것들, 써보고 나서 솔직하게 씁니다.',
    },
    'dev-quant': {
      label:    'Dev & Quant',
      cls:      'dev',
      headline: '<em>만들어</em>보고,<br><em>굴려</em>보는 것들에 대하여',
      desc:     '전공자는 아닙니다. 그래도 코드를 짜고, 자동화를 시도하고, 데이터로 투자를 들여다봅니다. 잘 되는 것보다 시도한 과정이 더 많이 남는 기록입니다.',
    },
  };

  return Object.entries(catMap).map(([slug, config]) => ({
    params: { category: slug },
    props: { config },
  }));
}

const { category } = Astro.params;
const { config }   = Astro.props;

const allPosts = await getCollection('posts');
const posts    = allPosts
  .filter(p => p.data.category === config.label)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured   = posts[0];
const listPosts  = posts.slice(1);

const readMin = (body: string) => Math.max(1, Math.ceil(body.split(/\s+/).length / 200));

// Category num for eyebrow
const numMap: Record<string, string> = {
  'travel-kids': '01', 'life-policy': '02', 'tech-gear': '03', 'dev-quant': '04',
};
const catNum = numMap[category] ?? '00';
---

<Layout title={`${config.label} — 다다노트`} currentCategorySlug={category}>
<style>
/* ── Category hero ──────────────────────────────── */
.cat-hero {
  display: grid; grid-template-columns: 1fr 1fr;
  min-height: 480px; border-bottom: 1px solid var(--line);
}
.cat-hero-left {
  padding: 72px 64px 72px 56px;
  display: flex; flex-direction: column; justify-content: space-between;
  border-right: 1px solid var(--line);
}
.cat-eyebrow {
  display: flex; align-items: center; gap: 10px; margin-bottom: 32px;
  font-family: var(--mono); font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted);
}
.cat-eyebrow .num { font-family: var(--serif); font-style: italic; font-size: 24px; color: var(--c-accent); letter-spacing: 0; text-transform: none; }
.cat-headline {
  font-family: var(--serif); font-weight: 300;
  font-size: clamp(36px, 4.5vw, 64px);
  line-height: 1.15; letter-spacing: -.025em; text-wrap: balance;
}
.cat-headline em { font-style: italic; color: var(--ink-2); }
.cat-hero-right {
  padding: 72px 56px 72px 64px;
  display: flex; flex-direction: column; justify-content: space-between;
}
.cat-desc {
  font-family: var(--serif); font-size: clamp(16px, 1.4vw, 19px);
  line-height: 1.75; color: var(--ink-2); font-weight: 300;
  text-wrap: pretty; max-width: 480px; flex-grow: 1;
}
.cat-stat { padding-top: 24px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
.cat-stat strong { font-size: 22px; font-weight: 600; color: var(--ink); letter-spacing: -.02em; }
.cat-stat span   { font-size: 12px; color: var(--muted); }

/* ── Featured ───────────────────────────────────── */
.featured-wrap { max-width: 1280px; margin: 0 auto; padding: 64px 56px; }
.featured-card {
  display: grid; grid-template-columns: 5fr 7fr; gap: 0;
  border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
  background: var(--bg-elev); min-height: 420px;
  transition: box-shadow .4s;
}
.featured-card:hover { box-shadow: 0 20px 60px oklch(0.15 0.01 85 / .09); }
.featured-img { overflow: hidden; background: oklch(0.93 0.02 80); }
.featured-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease-out); }
.featured-card:hover .featured-img img { transform: scale(1.03); }
.featured-body { padding: 44px 48px; display: flex; flex-direction: column; }
.featured-tag { font-family: var(--mono); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); margin-bottom: 20px; }
.featured-title {
  font-family: var(--serif); font-weight: 300;
  font-size: clamp(22px, 2vw, 32px); line-height: 1.25;
  letter-spacing: -.02em; margin-bottom: 18px; text-wrap: pretty;
}
.featured-dek { font-family: var(--serif); font-size: 15px; line-height: 1.7; color: var(--ink-2); font-weight: 300; flex-grow: 1; }
.featured-foot { display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--muted); margin-top: 28px; }
.featured-cta {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 13px; font-weight: 500; color: var(--ink);
  border-bottom: 1px solid var(--line-s); padding-bottom: 3px;
  margin-top: 16px; transition: border-color .2s;
}
.featured-cta:hover { border-color: var(--ink); }

/* ── Post list ──────────────────────────────────── */
.post-list-wrap { max-width: 1280px; margin: 0 auto; padding: 0 56px 96px; }
.post-list-head {
  display: flex; justify-content: space-between; align-items: baseline;
  font-family: var(--mono); font-size: 10.5px; letter-spacing: .2em;
  text-transform: uppercase; color: var(--muted);
  padding-bottom: 20px; border-bottom: 1px solid var(--line); margin-bottom: 0;
}
.post-row {
  display: grid; grid-template-columns: 56px 1fr 1fr auto auto;
  align-items: start; gap: 24px;
  padding: 28px 0; border-bottom: 1px solid var(--line);
  transition: padding-left .3s var(--ease-out);
}
.post-row:hover { padding-left: 12px; }
.post-row:hover .pr-arrow { transform: translateX(8px); color: var(--ink); }
.pr-num { font-family: var(--serif); font-style: italic; font-size: 20px; color: var(--muted); font-weight: 300; }
.pr-title { font-family: var(--serif); font-weight: 300; font-size: 20px; letter-spacing: -.01em; text-wrap: pretty; }
.pr-summary { font-size: 13px; color: var(--ink-2); line-height: 1.6; text-wrap: pretty; }
.pr-meta { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); white-space: nowrap; }
.pr-arrow { font-size: 18px; color: var(--muted); transition: transform .35s var(--ease-out), color .2s; align-self: center; }

/* ── CSS variable scoping for accent color ── */
.page-travel { --c-accent: var(--c-travel); }
.page-life   { --c-accent: var(--c-life);   }
.page-tech   { --c-accent: var(--c-tech);   }
.page-dev    { --c-accent: var(--c-dev);    }

/* ── Responsive ─────────────────────────────────── */
@media (max-width: 900px) {
  .cat-hero { grid-template-columns: 1fr; }
  .cat-hero-left { border-right: none; border-bottom: 1px solid var(--line); padding: 48px 24px; }
  .cat-hero-right { padding: 40px 24px 48px; }
  .featured-wrap, .post-list-wrap { padding-left: 20px; padding-right: 20px; }
  .featured-card { grid-template-columns: 1fr; }
  .featured-img { min-height: 220px; }
  .featured-body { padding: 28px 24px; }
  .post-row { grid-template-columns: 36px 1fr auto; gap: 12px; }
  .pr-summary, .pr-meta { display: none; }
}
</style>

<div class={`page-${config.cls}`}>

<!-- Category hero -->
<header class="cat-hero">
  <div class="cat-hero-left">
    <div>
      <div class="cat-eyebrow">
        <span class="num">{catNum}</span>
        <span>—</span>
        <span class={`cat ${config.cls}`}><span class="dot"></span>{config.label}</span>
      </div>
      <h1 class="cat-headline reveal" set:html={config.headline}></h1>
    </div>
  </div>
  <div class="cat-hero-right">
    <p class="cat-desc reveal" style="transition-delay:.08s">{config.desc}</p>
    <div class="cat-stat reveal" style="transition-delay:.12s">
      <strong>{posts.length}</strong>
      <span>편의 글</span>
    </div>
  </div>
</header>

<!-- Featured post -->
{featured && (
  <section class="featured-wrap">
    <div class="section-head reveal">이번 호의 글</div>
    <a href={`/posts/${featured.id}`} class="featured-card reveal">
      <div class="featured-img">
        {featured.data.image
          ? <img src={featured.data.image} alt={featured.data.title} loading="lazy" />
          : <div style="width:100%;height:100%;background:oklch(0.93 0.02 80)"></div>
        }
      </div>
      <div class="featured-body">
        <p class="featured-tag">★ Featured</p>
        <h2 class="featured-title">{featured.data.title}</h2>
        <p class="featured-dek">{featured.data.summary}</p>
        <div class="featured-foot">
          <time>{featured.data.date.toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric'})}</time>
          <span>·</span>
          <span>{readMin(featured.body)}분 분량</span>
        </div>
        <p class="featured-cta">전문 읽기 →</p>
      </div>
    </a>
  </section>
)}

<!-- Post list -->
{listPosts.length > 0 && (
  <section class="post-list-wrap">
    <div class="post-list-head">
      <span>지난 글들</span>
      <span>{listPosts.length} POSTS</span>
    </div>
    {listPosts.map((post, i) => (
      <a href={`/posts/${post.id}`}
         class="post-row reveal"
         style={`transition-delay:${(i * 0.04).toFixed(2)}s`}>
        <span class="pr-num">№{String(i + 2).padStart(2, '0')}</span>
        <h3 class="pr-title">{post.data.title}</h3>
        <p class="pr-summary">{post.data.summary}</p>
        <div class="pr-meta">
          <time>{post.data.date.toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric'})}</time>
          <span>{readMin(post.body)}분 분량</span>
        </div>
        <span class="pr-arrow">→</span>
      </a>
    ))}
  </section>
)}

</div>
</Layout>
