---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "최신 IT 정보와 수익형 블로그 운영 노하우를 공유합니다." } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
	</head>
	<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col font-sans selection:bg-blue-500/30">
		<!-- Header / Navigation -->
		<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/80 border-b border-slate-200">
			<div class="max-w-6xl mx-auto px-5 h-16 flex items-center justify-between">
				<a href="/" class="text-xl font-bold text-slate-950 tracking-tight flex items-center gap-2">
					<img src="/logo.png" alt="다다노트 로고" class="w-8 h-8 rounded-lg object-cover shadow-sm" />
					다다노트
				</a>
				
				<nav class="hidden md:flex gap-8">
					<a href="/travel-kids" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Travel & Kids</a>
					<a href="/life-policy" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Life & Policy</a>
					<a href="/tech-gear" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Tech & Gear</a>
					<a href="/dev-quant" class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors">Dev & Quant</a>
				</nav>

				<button aria-label="Search" class="p-2 text-slate-600 hover:text-blue-600 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
				</button>
			</div>
		</header>

		<!-- Main Content -->
		<main class="flex-grow w-full max-w-6xl mx-auto px-5 py-8 md:py-12">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="border-t border-slate-200 bg-white py-10 mt-12">
			<div class="max-w-6xl mx-auto px-5 text-center flex flex-col md:flex-row justify-between items-center gap-4">
				<p class="text-slate-500 text-sm">© {new Date().getFullYear()} 다다노트. All rights reserved.</p>
				<div class="flex gap-4">
					<a href="/about" class="text-sm text-slate-500 hover:text-slate-800 transition-colors">About</a>
					<a href="/privacy" class="text-sm text-slate-500 hover:text-slate-800 transition-colors">Privacy Policy</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
	}
	/* 눈이 편안한 폰트 스택 적용 */
	html {
		font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, 'Helvetica Neue', 'Segoe UI', 'Apple SD Gothic Neo', 'Noto Sans KR', 'Malgun Gothic', sans-serif;
	}
</style>
