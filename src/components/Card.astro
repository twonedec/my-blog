---
interface Props {
  title:    string;
  summary:  string;
  date:     string;
  category: string;
  image?:   string;
  href:     string;
  readMin?: number;
}

const { title, summary, date, category, image, href, readMin } = Astro.props;

const cls = category.toLowerCase().split(' ')[0];
---

<a href={href} class="bento-card">
  <div class="bento-thumb">
    {image
      ? <img src={image} alt={title} loading="lazy" />
      : <div class="ph"></div>
    }
  </div>
  <div class="bento-body">
    <span class={`cat ${cls}`}><span class="dot"></span>{category}</span>
    <h3 class="bento-title">{title}</h3>
    <p class="bento-summary">{summary}</p>
    <div class="bento-foot">
      <time class="bento-date">{date}</time>
      {readMin && <span class="bento-read">{readMin}분 분량</span>}
    </div>
  </div>
</a>

<style>
.bento-card {
  border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
  background: var(--bg-elev); display: flex; flex-direction: column;
  transition: transform .35s var(--ease-out), box-shadow .35s;
}
.bento-card:hover { transform: translateY(-4px); box-shadow: 0 16px 48px oklch(0.15 0.01 85 / .09); }
.bento-thumb {
  flex: 0 0 54%; overflow: hidden; background: oklch(0.93 0.015 85);
}
.bento-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease-out); }
.bento-card:hover .bento-thumb img { transform: scale(1.05); }
.ph { width: 100%; height: 100%; }
.bento-body { padding: 18px 22px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
.bento-title { font-family: var(--serif); font-size: 15px; font-weight: 400; line-height: 1.4; letter-spacing: -.01em; text-wrap: pretty; }
.bento-summary {
  font-size: 12px; color: var(--ink-2); line-height: 1.55;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden; text-wrap: pretty;
}
.bento-foot {
  display: flex; align-items: center; gap: 8px;
  font-size: 11px; color: var(--muted); margin-top: auto;
}
.bento-read::before { content: "·"; margin-right: 8px; }
</style>
