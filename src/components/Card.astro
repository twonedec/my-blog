---
// src/components/Card.astro
interface Props {
	title: string;
	summary: string;
	date: string;
	category: string;
	href: string;
}

const { title, summary, date, category, href } = Astro.props;
---

<a href={href} class="group block h-full outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-2xl">
	<article class="flex flex-col h-full p-6 rounded-2xl bg-white border border-slate-200 hover:border-blue-500/30 transition-all duration-300 ease-out hover:-translate-y-1.5 hover:shadow-lg hover:shadow-blue-500/10">
		
		<!-- Meta Info -->
		<div class="flex items-center gap-3 mb-4">
			<span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wide bg-blue-50 text-blue-600 ring-1 ring-inset ring-blue-500/20">
				{category}
			</span>
			<time class="text-xs text-slate-500 font-medium">{date}</time>
		</div>
		
		<!-- Title -->
		<h3 class="text-xl font-bold text-slate-900 mb-3 leading-snug group-hover:text-blue-600 transition-colors line-clamp-2">
			{title}
		</h3>
		
		<!-- Summary -->
		<p class="text-slate-600 text-sm leading-relaxed mb-6 line-clamp-3 flex-grow">
			{summary}
		</p>
		
		<!-- Action text -->
		<div class="mt-auto pt-4 border-t border-slate-100 flex items-center text-sm font-medium text-slate-500 group-hover:text-blue-600 transition-colors">
			Read post 
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
			</svg>
		</div>
	</article>
</a>
