---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts    = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const readMin = (body: string) => Math.max(1, Math.ceil(body.split(/\s+/).length / 200));

const catCls = (cat: string) => {
  if (cat.startsWith('Travel')) return 'travel';
  if (cat.startsWith('Life'))   return 'life';
  if (cat.startsWith('Tech'))   return 'tech';
  if (cat.startsWith('Dev'))    return 'dev';
  return '';
};

const categories = ['전체', ...Array.from(new Set(posts.map(p => p.data.category))).sort()];

const byYear = posts.reduce<Record<number, typeof posts>>((acc, p) => {
  const y = p.data.date.getFullYear();
  (acc[y] ??= []).push(p);
  return acc;
}, {});

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---

<Layout title="아카이브 — 다다노트">
<style>
.arch-header {
  padding: 72px 56px 60px;
  border-bottom: 1px solid var(--line);
}
.arch-strip {
  display: flex; justify-content: space-between; align-items: baseline;
  border-bottom: 1px solid var(--line);
  padding-bottom: 16px; margin-bottom: 52px;
  font-family: var(--mono); font-size: 10.5px; color: var(--muted);
  letter-spacing: .09em; text-transform: uppercase;
}
.arch-strip a { color: var(--muted); transition: color .2s; }
.arch-strip a:hover { color: var(--ink); }

.arch-headline {
  font-family: var(--serif); font-weight: 300;
  font-size: clamp(36px, 4.5vw, 64px);
  line-height: 1.06; letter-spacing: -.025em; color: var(--ink);
  margin-bottom: 20px;
}
.arch-headline em { font-style: italic; color: var(--ink-2); }
.arch-sub {
  font-family: var(--serif); font-style: italic;
  font-size: 18px; color: var(--muted); font-weight: 300;
}
.arch-stats {
  display: flex; gap: 32px; margin-top: 36px;
  font-size: 12px; color: var(--muted); letter-spacing: .02em;
}
.arch-stats div { display: flex; flex-direction: column; gap: 4px; }
.arch-stats strong { font-size: 24px; font-weight: 600; color: var(--ink); letter-spacing: -.02em; }

/* ── Year groups ─────────────────────────────── */
.arch-body { padding: 0 56px 80px; }

.year-group { margin-top: 56px; }
.year-label {
  font-family: var(--serif); font-style: italic;
  font-size: clamp(48px, 6vw, 80px); font-weight: 300;
  color: var(--faint); letter-spacing: -.03em;
  line-height: 1; margin-bottom: 4px;
  border-bottom: 1px solid var(--line); padding-bottom: 16px;
}

.post-row {
  display: grid;
  grid-template-columns: 120px 1fr auto 80px;
  align-items: center; gap: 28px;
  padding: 22px 0; border-bottom: 1px solid var(--line);
  position: relative;
}
.post-row::before {
  content: ""; position: absolute; inset: 0 -12px;
  background: var(--bg-soft); opacity: 0; transition: opacity .3s;
  pointer-events: none; border-radius: 6px;
}
.post-row:hover::before { opacity: 1; }
.post-row > * { position: relative; }

.pr-date {
  font-family: var(--mono); font-size: 11.5px; color: var(--muted);
  letter-spacing: .04em;
}
.pr-title {
  font-family: var(--serif); font-weight: 400; font-size: 20px;
  line-height: 1.3; letter-spacing: -.01em; color: var(--ink);
  transition: color .2s;
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
}
.post-row:hover .pr-title { color: var(--ink-2); }

.pr-cat { justify-self: end; }

.pr-arrow {
  justify-self: end;
  font-family: var(--serif); font-size: 22px; color: var(--muted);
  font-weight: 200; transition: transform .3s var(--ease-out), color .2s;
}
.post-row:hover .pr-arrow { transform: translateX(6px); color: var(--ink); }

/* ── Category filter ─────────────────────────── */
.cat-filter {
  display: flex; flex-wrap: wrap; gap: 8px;
  padding: 32px 56px 0;
}
.cat-btn {
  font-family: var(--mono); font-size: 11px; letter-spacing: .07em;
  text-transform: uppercase; padding: 6px 14px;
  border: 1px solid var(--line); border-radius: 999px;
  background: transparent; color: var(--muted);
  cursor: pointer; transition: all .2s;
}
.cat-btn:hover { border-color: var(--ink-2); color: var(--ink); }
.cat-btn.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }

.post-row[data-hidden] { display: none; }

/* ── Responsive ──────────────────────────────── */
@media (max-width: 768px) {
  .arch-header, .arch-body { padding-left: 20px; padding-right: 20px; }
  .arch-header { padding-top: 48px; padding-bottom: 40px; }
  .arch-strip { display: none; }
  .post-row { grid-template-columns: 80px 1fr 32px; }
  .pr-cat { display: none; }
  .pr-title { font-size: 16px; }
}
</style>

<div class="cat-filter">
  {categories.map(cat => (
    <button class={`cat-btn${cat === '전체' ? ' active' : ''}`} data-cat={cat}>{cat}</button>
  ))}
</div>

<header class="arch-header">
  <div class="arch-strip">
    <div style="display:flex;gap:10px;align-items:baseline">
      <a href="/">다다노트</a>
      <span style="opacity:.5">/</span>
      <span style="color:var(--ink)">Archive</span>
    </div>
    <span>TOTAL {posts.length} POSTS</span>
  </div>

  <h1 class="arch-headline reveal">모든 기록,<br><em>시간순으로</em></h1>
  <p class="arch-sub reveal" style="transition-delay:.08s">All notes, from first to last</p>

  <div class="arch-stats reveal" style="transition-delay:.16s">
    <div>
      <strong>{posts.length}</strong>
      <span>편의 글</span>
    </div>
    <div>
      <strong>{years.length}</strong>
      <span>년의 기록</span>
    </div>
  </div>
</header>

<div class="arch-body">
  {years.map(year => (
    <div class="year-group reveal">
      <div class="year-label">{year}</div>
      {byYear[year].map((post, i) => (
        <a href={`/posts/${post.id}`}
           class="post-row"
           data-category={post.data.category}
           style={`transition-delay:${(i * 0.03).toFixed(2)}s`}>
          <span class="pr-date">
            {post.data.date.toLocaleDateString('ko-KR', { month: '2-digit', day: '2-digit' })}
            &nbsp;·&nbsp;{readMin(post.body ?? '')}분
          </span>
          <h3 class="pr-title">{post.data.title}</h3>
          <span class={`cat ${catCls(post.data.category)} pr-cat`}>
            <span class="dot"></span>{post.data.category}
          </span>
          <span class="pr-arrow">→</span>
        </a>
      ))}
    </div>
  ))}
</div>

<script>
const btns = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
const rows = document.querySelectorAll<HTMLElement>('.post-row');
const groups = document.querySelectorAll<HTMLElement>('.year-group');

btns.forEach(btn => {
  btn.addEventListener('click', () => {
    btns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const cat = btn.dataset.cat!;
    rows.forEach(row => {
      const match = cat === '전체' || row.dataset.category === cat;
      row.toggleAttribute('data-hidden', !match);
    });
    groups.forEach(g => {
      const visible = g.querySelectorAll('.post-row:not([data-hidden])').length > 0;
      (g as HTMLElement).style.display = visible ? '' : 'none';
    });
  });
});
</script>

</Layout>
