---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const labPosts = (await getCollection('lab', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="Lab 기술 자료실 — twonelab" currentCategorySlug="lab">
<style>
.lab-index-wrap {
  max-width: 960px;
  margin: 0 auto;
  padding: 64px 24px 120px;
}

.lab-index-header {
  margin-bottom: 56px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--line);
}

.lab-strip {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}

.lab-strip a {
  color: var(--muted);
  text-decoration: none;
  transition: color 0.2s;
}
.lab-strip a:hover {
  color: var(--ink);
}

.lab-headline {
  font-family: var(--sans);
  font-weight: 700;
  font-size: clamp(32px, 4vw, 48px);
  letter-spacing: -0.03em;
  color: var(--ink);
  line-height: 1.2;
  margin-bottom: 16px;
}

.lab-desc {
  font-size: 16px;
  line-height: 1.7;
  color: var(--ink-2);
  max-width: 680px;
}

.lab-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.lab-item-card {
  background: var(--bg-elev);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 28px 32px;
  text-decoration: none !important;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  transition: transform 0.25s var(--ease-out), border-color 0.25s, box-shadow 0.25s;
}

.lab-item-card:hover {
  transform: translateY(-3px);
  border-color: var(--line-s);
  box-shadow: 0 12px 32px -12px rgba(0, 0, 0, 0.08);
}

.lab-item-left {
  flex: 1;
}

.lab-item-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.lab-badge {
  font-family: var(--mono);
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: var(--bg-soft);
  color: var(--ink);
  padding: 3px 9px;
  border-radius: 4px;
  border: 1px solid var(--line-s);
}

.lab-date {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--muted);
}

.lab-item-title {
  font-family: var(--sans);
  font-size: 20px;
  font-weight: 600;
  line-height: 1.35;
  color: var(--ink);
  letter-spacing: -0.015em;
  margin-bottom: 8px;
}

.lab-item-summary {
  font-size: 14px;
  line-height: 1.6;
  color: var(--ink-2);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.lab-item-arrow {
  font-size: 20px;
  color: var(--muted);
  transition: transform 0.2s, color 0.2s;
  flex-shrink: 0;
}

.lab-item-card:hover .lab-item-arrow {
  transform: translateX(6px);
  color: var(--ink);
}

@media (max-width: 768px) {
  .lab-index-wrap {
    padding: 40px 20px 80px;
  }
  .lab-item-card {
    padding: 22px;
    flex-direction: column;
    align-items: flex-start;
  }
  .lab-item-arrow {
    display: none;
  }
}
</style>

<div class="lab-index-wrap">
  <header class="lab-index-header reveal">
    <div class="lab-strip">
      <span><a href="/">twonelab</a> / Lab 자료실</span>
      <span>{labPosts.length} Resource Items</span>
    </div>
    <h1 class="lab-headline">twonelab 공식 기술 자료실</h1>
    <p class="lab-desc">
      유튜브 쇼츠 및 영상에서 시연한 AI 프롬프트 원문, 파이썬 자동화 스크립트, 퀀트 시스템 코드를 원클릭으로 복사하고 바로 실무에 적용할 수 있는 공식 배포처입니다.
    </p>
  </header>

  <div class="lab-list">
    {labPosts.map((post, i) => (
      <a href={`/lab/${post.id}/`} class="lab-item-card reveal" style={`transition-delay:${(i * 0.06).toFixed(2)}s`}>
        <div class="lab-item-left">
          <div class="lab-item-meta">
            <span class="lab-badge">{post.data.categoryBadge || "TECH RESOURCE"}</span>
            <time class="lab-date">{fmtDate(post.data.date)}</time>
          </div>
          <h2 class="lab-item-title">{post.data.title}</h2>
          <p class="lab-item-summary">{post.data.summary}</p>
        </div>
        <div class="lab-item-arrow" aria-hidden="true">→</div>
      </a>
    ))}
  </div>
</div>
</Layout>
