---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const labPosts = await getCollection('lab', ({ data }) => !data.draft);
  return labPosts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 추천 테크 글 3편 가져오기 (Dev & Quant, Tech & Gear 중에서 엄선)
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const recommendedPosts = allPosts
  .filter(p => p.data.category === 'Dev & Quant' || p.data.category === 'Tech & Gear')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formattedDate = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<Layout title={`${post.data.title} — twonelab 공식 자료실`} description={post.data.summary}>
<style is:global>
/* ── Lab Container ──────────────────────────────── */
.lab-wrap {
  max-width: 860px;
  margin: 0 auto;
  padding: 48px 24px 96px;
}

/* ── Secret Breadcrumb ───────────────────────────── */
.lab-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  color: var(--muted);
  text-transform: uppercase;
}
.lab-top-bar a {
  color: var(--ink-2);
  display: flex;
  align-items: center;
  gap: 6px;
  transition: color 0.2s;
}
.lab-top-bar a:hover { color: var(--ink); }
.lab-badge {
  background: #eff6ff;
  color: #2563eb;
  padding: 3px 8px;
  border-radius: 4px;
  font-weight: 700;
  border: 1px solid #bfdbfe;
}

/* ── Header ─────────────────────────────────────── */
.lab-header { margin-bottom: 36px; }
.lab-title {
  font-family: var(--serif);
  font-weight: 400;
  font-size: clamp(28px, 3.8vw, 42px);
  line-height: 1.25;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin-bottom: 18px;
  text-wrap: pretty;
}
.lab-lead {
  font-family: var(--serif);
  font-size: clamp(16px, 1.3vw, 18px);
  line-height: 1.75;
  color: var(--ink-2);
  font-weight: 300;
  border-left: 3px solid #2563eb;
  padding-left: 18px;
  margin-bottom: 24px;
}

/* ── Body Typography ────────────────────────────── */
.lab-body {
  font-family: var(--serif);
  font-size: clamp(16px, 1.25vw, 18px);
  line-height: 1.95;
  color: var(--ink);
  font-weight: 300;
  margin-bottom: 56px;
}
.lab-body p { margin-bottom: 1.6em; text-wrap: pretty; }
.lab-body h2 {
  font-family: var(--serif);
  font-weight: 500;
  font-size: clamp(20px, 2vw, 25px);
  letter-spacing: -0.02em;
  margin: 2.5em 0 1em;
  padding-top: 1.5em;
  border-top: 1px solid var(--line);
  color: var(--ink);
}
.lab-body ul, .lab-body ol {
  margin-bottom: 1.8em;
  padding-left: 1.4em;
}
.lab-body li { margin-bottom: 0.6em; }
.lab-body strong { font-weight: 600; color: var(--ink); }

/* ── [핵심 UX] 원클릭 복사 프롬프트 박스 ──────────────── */
.lab-body pre {
  background: #0f172a !important;
  border: 1px solid #334155;
  border-radius: 8px;
  padding: 18px 20px;
  overflow-x: auto;
  position: relative;
  margin: 1.8em 0 2.4em;
  box-shadow: 0 8px 24px -8px rgba(0,0,0,0.15);
}
.lab-body pre code {
  font-family: var(--mono);
  font-size: 14px;
  line-height: 1.7;
  color: #e2e8f0;
  background: transparent !important;
  padding: 0 !important;
}

/* 복사 버튼 래퍼 */
.copy-banner {
  background: #1e293b;
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  border: 1px solid #334155;
  border-bottom: none;
  padding: 10px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: -1.8em;
  position: relative;
  z-index: 2;
}
.copy-banner-label {
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
  color: #94a3b8;
  display: flex;
  align-items: center;
  gap: 6px;
}
.copy-action-btn {
  background: #2563eb;
  color: #ffffff;
  border: none;
  padding: 6px 14px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.15s;
}
.copy-action-btn:hover { background: #1d4ed8; }
.copy-action-btn:active { transform: scale(0.97); }
.copy-action-btn.copied { background: #059669; }

/* ── 크몽 CTA 배너 ───────────────────────────────── */
.kmong-cta-box {
  background: var(--ink);
  color: var(--bg-elev);
  border-radius: 12px;
  padding: 32px 36px;
  margin: 48px 0 64px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-shadow: 0 16px 36px -12px rgba(0,0,0,0.25);
}
.kmong-cta-eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #94a3b8;
}
.kmong-cta-title {
  font-family: var(--serif);
  font-size: 22px;
  font-weight: 400;
  color: #ffffff;
  line-height: 1.35;
}
.kmong-cta-desc {
  font-size: 14.5px;
  color: #cbd5e1;
  line-height: 1.65;
}
.kmong-cta-btn {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #facc15;
  color: #0f172a;
  padding: 10px 20px;
  border-radius: 6px;
  font-size: 13.5px;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.2s;
  margin-top: 6px;
}
.kmong-cta-btn:hover { background: #eab308; }

/* ── [핵심] 다른 글 노출 추천 그리드 ─────────────── */
.recommended-section {
  padding-top: 40px;
  border-top: 1px solid var(--line);
  margin-top: 40px;
}
.recommended-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24px;
}
.recommended-title {
  font-family: var(--serif);
  font-size: 21px;
  font-weight: 500;
  color: var(--ink);
}
.recommended-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 32px;
}
.rec-card {
  background: var(--bg-elev);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.2s, box-shadow 0.2s;
  text-decoration: none;
}
.rec-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 24px -10px rgba(0,0,0,0.1);
  border-color: var(--line-s);
}
.rec-cat {
  font-family: var(--mono);
  font-size: 10.5px;
  color: var(--muted);
  margin-bottom: 8px;
  text-transform: uppercase;
}
.rec-title {
  font-family: var(--serif);
  font-size: 16.5px;
  font-weight: 500;
  line-height: 1.35;
  color: var(--ink);
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.rec-desc {
  font-size: 12.5px;
  color: var(--ink-2);
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 14px;
}
.rec-more {
  font-size: 12px;
  font-weight: 600;
  color: var(--ink);
  margin-top: auto;
}

.home-jump-btn {
  display: flex;
  justify-content: center;
  margin-top: 12px;
}
.home-jump-btn a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 500;
  color: var(--ink);
  background: var(--bg-soft);
  border: 1px solid var(--line-s);
  padding: 12px 24px;
  border-radius: 30px;
  transition: all 0.2s;
}
.home-jump-btn a:hover {
  background: var(--ink);
  color: #ffffff;
}

@media (max-width: 768px) {
  .lab-wrap { padding: 32px 18px 64px; }
  .kmong-cta-box { padding: 24px; }
  .kmong-cta-btn { width: 100%; justify-content: center; }
  .recommended-grid { grid-template-columns: 1fr; }
}
</style>

<div class="lab-wrap">
  <!-- 상단 시크릿 바 -->
  <div class="lab-top-bar">
    <div style="display: flex; align-items: center; gap: 8px;">
      <span class="lab-badge">SHORTS RESOURCE</span>
      <span>twonelab 공식 배포처</span>
    </div>
    <a href="/">← dadanote 홈으로</a>
  </div>

  <!-- 헤더 -->
  <header class="lab-header">
    <h1 class="lab-title">{post.data.title}</h1>
    <p class="lab-lead">{post.data.summary}</p>
    <div style="font-size: 12px; color: var(--muted); font-family: var(--mono);">
      배포일: {formattedDate}
    </div>
  </header>

  <!-- 본문 (프롬프트 및 설명) -->
  <article class="lab-body">
    <Content />
  </article>

  <!-- 크몽 CTA 배너 -->
  <div class="kmong-cta-box">
    <div class="kmong-cta-eyebrow">TWONELAB × KMONG</div>
    <h3 class="kmong-cta-title">더 강력한 전자동 무인 자동화가 필요하신가요?</h3>
    <p class="kmong-cta-desc">
      매번 손으로 복사해서 AI에 붙여넣을 필요 없이, 매일 정해진 시간에 꿀키워드를 추출하고 네이버 블로그에 포스팅까지 자동으로 쏴주는 <strong>twonelab의 100% 무인 파이썬 자동화 파이프라인</strong>을 크몽에서 만나보세요.
    </p>
    <a href="https://kmong.com/gig/785584" target="_blank" class="kmong-cta-btn">
      크몽에서 전체 솔루션 확인하기 ↗
    </a>
  </div>

  <!-- [핵심] 다른 글 노출 추천 섹션 -->
  <section class="recommended-section">
    <div class="recommended-head">
      <h3 class="recommended-title">함께 읽으면 좋은 twonelab의 추천 테크 기록</h3>
      <span style="font-size: 12px; color: var(--muted); font-family: var(--mono);">CURATED POSTS</span>
    </div>

    <div class="recommended-grid">
      {recommendedPosts.map(p => (
        <a href={`/posts/${p.id}/`} class="rec-card">
          <div>
            <div class="rec-cat">{p.data.category}</div>
            <h4 class="rec-title">{p.data.title}</h4>
            <p class="rec-desc">{p.data.summary}</p>
          </div>
          <span class="rec-more">글 읽어보기 →</span>
        </a>
      ))}
    </div>

    <div class="home-jump-btn">
      <a href="/">
        <span>📚 dadanote 전체 엔지니어링 글 둘러보기</span>
        <span>→</span>
      </a>
    </div>
  </section>
</div>

<!-- 원클릭 복사 스크립트 -->
<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const codeBlocks = document.querySelectorAll('.lab-body pre');
  codeBlocks.forEach((pre, idx) => {
    // 배너 헤더 동적 생성
    const banner = document.createElement('div');
    banner.className = 'copy-banner';
    banner.innerHTML = `
      <div class="copy-banner-label">
        <span>✨</span> TWONELAB PROMPT · 복사해서 바로 사용하세요
      </div>
      <button class="copy-action-btn" id="copy-btn-${idx}">
        <span class="btn-icon">📋</span>
        <span class="btn-text">복사하기</span>
      </button>
    `;
    
    pre.parentNode.insertBefore(banner, pre);

    const btn = banner.querySelector('.copy-action-btn');
    const textSpan = btn.querySelector('.btn-text');
    const iconSpan = btn.querySelector('.btn-icon');

    btn.addEventListener('click', () => {
      const codeText = pre.querySelector('code') ? pre.querySelector('code').innerText : pre.innerText;
      navigator.clipboard.writeText(codeText.trim()).then(() => {
        btn.classList.add('copied');
        textSpan.innerText = '복사 완료! ✓';
        iconSpan.innerText = '✓';
        setTimeout(() => {
          btn.classList.remove('copied');
          textSpan.innerText = '복사하기';
          iconSpan.innerText = '📋';
        }, 2000);
      });
    });
  });
});
</script>
</Layout>
