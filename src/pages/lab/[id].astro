---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const labPosts = await getCollection('lab', ({ data }) => !data.draft);
  return labPosts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 지능형 맞춤 큐레이션 추천 시스템
const allDevPosts = (await getCollection('posts', ({ data }) => !data.draft && (data.category === 'Dev & Quant' || data.category === 'Tech & Gear')))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const isStockPost = post.id.includes('stock') || (post.data.tags && post.data.tags.some(t => t.includes('주식') || t.includes('퀀트')));

interface RecommendedItem {
  url: string;
  badge: string;
  title: string;
  summary: string;
}

let recommendedItems: RecommendedItem[] = [];
let sectionTitle = "함께 읽으면 좋은 twonelab의 추천 테크 기록";

if (isStockPost) {
  sectionTitle = "함께 읽으면 좋은 실전 퀀트 & 자동화 엔지니어링";
  const priorityStockIds = ['2026-05-15-dev-001', '2026-05-28-dev-001', '2026-06-17-dev-001'];
  const matchedPosts = priorityStockIds.map(id => allDevPosts.find(p => p.id === id)).filter(Boolean) as typeof allDevPosts;
  const otherPosts = allDevPosts.filter(p => !priorityStockIds.includes(p.id));
  const pool = [...matchedPosts, ...otherPosts];

  recommendedItems = pool.slice(0, 3).map(p => ({
    url: `/posts/${p.id}/`,
    badge: 'Dev & Quant',
    title: p.data.title,
    summary: p.data.summary,
  }));
} else {
  sectionTitle = "함께 읽으면 좋은 dadanote 실전 엔지니어링 기록";
  // 블로그 글인 경우: dadanote 본진의 대표 개발/자동화 실전기 3편을 엄선 추천
  const priorityDevIds = ['2026-06-29-dev-001', '2026-05-15-dev-001', '2026-06-02-dev-001'];
  const matchedDev = priorityDevIds.map(id => allDevPosts.find(p => p.id === id)).filter(Boolean) as typeof allDevPosts;
  const otherDev = allDevPosts.filter(p => !priorityDevIds.includes(p.id));
  const pool = [...matchedDev, ...otherDev];

  recommendedItems = pool.slice(0, 3).map(p => ({
    url: `/posts/${p.id}/`,
    badge: 'Dev & Quant',
    title: p.data.title,
    summary: p.data.summary,
  }));
}

// CTA 박스 동적 분기
const ctaEyebrow = isStockPost ? "TWONELAB QUANT ENGINE" : "TWONELAB AUTOMATION";
const ctaTitle = isStockPost
  ? "전 종목을 전수 스크리닝하는 실전 퀀트 자동화 시스템"
  : "반복 작업을 1초로 압축하는 전용 자동화 솔루션";
const ctaDesc = isStockPost
  ? "DART 전자공시 재무제표와 주가를 실시간 연동해 피터 린치 GARP, 버핏 안전마진, 외인/기관 세력 수급까지 3중으로 전 종목을 자동 스크리닝하는 twonelab 퀀트 시스템과 구축 노하우를 확인해보세요."
  : "매번 손으로 복사하고 정리할 필요 없이, 시드 키워드 전수조사부터 3중 필터링, 상업성 지표 산출까지 엑셀로 원클릭 완성해 주는 twonelab의 영구소장용 윈도우 무제한 프로그램을 크몽에서 만나보세요.";
const ctaBtnText = isStockPost
  ? "크몽 퀀트 자동화 노하우 보기 ↗"
  : "크몽에서 솔루션 상세 보기 ↗";
const ctaUrl = isStockPost
  ? "https://kmong.com"
  : "https://kmong.com/gig/785584";

const formattedDate = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<Layout title={`${post.data.title} — twonelab 공식 자료실`} description={post.data.summary}>
<style is:global>
/* ── Lab Container ──────────────────────────────── */
.lab-wrap {
  max-width: 820px;
  margin: 0 auto;
  padding: 56px 24px 96px;
}

/* ── Minimal Breadcrumb / Top Bar ────────────────── */
.lab-nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
}
.lab-back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  transition: color 0.2s;
}
.lab-back-link:hover {
  color: var(--ink);
}
.lab-back-link svg {
  transition: transform 0.2s var(--ease-out);
}
.lab-back-link:hover svg {
  transform: translateX(-3px);
}
.lab-category-tag {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-2);
  background: var(--bg-soft);
  border: 1px solid var(--line-s);
  padding: 3px 8px;
  border-radius: 4px;
}

/* ── Header ─────────────────────────────────────── */
.lab-header {
  margin-bottom: 40px;
}
.lab-title {
  font-family: var(--sans);
  font-weight: 600;
  font-size: clamp(26px, 3.5vw, 36px);
  line-height: 1.35;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin-bottom: 20px;
  text-wrap: pretty;
}
.lab-lead {
  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.7;
  color: var(--ink-2);
  font-weight: 400;
  border-left: 2px solid var(--line-s);
  padding-left: 18px;
  margin-bottom: 16px;
  text-wrap: pretty;
}
.lab-meta {
  font-family: var(--mono);
  font-size: 11.5px;
  color: var(--muted);
}

/* ── Body Typography ────────────────────────────── */
.lab-body {
  font-family: var(--sans);
  font-size: 16.5px;
  line-height: 1.8;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin-bottom: 48px;
}
.lab-body p {
  margin-bottom: 1.6em;
  color: var(--ink-2);
  word-break: keep-all;
  overflow-wrap: break-word;
}
.lab-body strong {
  font-weight: 600;
  color: var(--ink);
}
.lab-body em {
  font-style: italic;
}
.lab-body h2 {
  font-family: var(--sans);
  font-weight: 600;
  font-size: clamp(20px, 2.2vw, 24px);
  letter-spacing: -0.02em;
  line-height: 1.4;
  margin: 2.8em 0 1em;
  padding-top: 1.6em;
  border-top: 1px solid var(--line);
  color: var(--ink);
}
.lab-body h2:first-child {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}
.lab-body h3 {
  font-family: var(--sans);
  font-weight: 600;
  font-size: clamp(17px, 1.8vw, 19px);
  letter-spacing: -0.015em;
  line-height: 1.45;
  margin: 2em 0 0.8em;
  color: var(--ink);
}
.lab-body ul, .lab-body ol {
  margin: 1.2em 0 1.8em;
  padding-left: 1.4em;
  color: var(--ink-2);
}
.lab-body li {
  margin-bottom: 0.6em;
  line-height: 1.75;
}
.lab-body li strong {
  color: var(--ink);
}
.lab-body blockquote {
  margin: 2em 0;
  padding: 16px 20px;
  background: var(--bg-soft);
  border-left: 3px solid var(--ink);
  border-radius: 6px;
  color: var(--ink-2);
  font-size: 15px;
  line-height: 1.7;
}
.lab-body hr {
  border: none;
  border-top: 1px solid var(--line);
  margin: 2.8em 0;
}
.lab-body a {
  color: var(--ink);
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-color: var(--line-s);
  transition: text-decoration-color 0.2s;
}
.lab-body a:hover {
  text-decoration-color: var(--ink);
}

/* ── Tables (Card Style) ───────────────────────── */
.lab-body table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin: 2.2em 0;
  font-size: 14px;
  line-height: 1.6;
  border: 1px solid var(--line-s);
  border-radius: 8px;
  overflow: hidden;
  background: var(--bg-elev);
}
.lab-body th {
  background: var(--bg-soft);
  border-bottom: 1px solid var(--line-s);
  padding: 12px 16px;
  text-align: left;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  letter-spacing: -0.01em;
}
.lab-body td {
  border-bottom: 1px solid var(--line);
  padding: 12px 16px;
  color: var(--ink-2);
  vertical-align: middle;
}
.lab-body tr:last-child td {
  border-bottom: none;
}
.lab-body tr:hover td {
  background: color-mix(in oklab, var(--bg-soft) 40%, transparent);
}
.lab-body td code, .lab-body th code {
  font-family: var(--sans);
  font-weight: 600;
  font-size: 12px;
  padding: 3px 8px;
  border-radius: 4px;
  display: inline-block;
  white-space: nowrap;
  border: 1px solid var(--line-s);
  background: var(--bg-soft);
  color: var(--ink);
}

/* ── Code & Pre ──────────────────────────────────── */
.lab-body :not(pre) > code {
  background: var(--bg-soft);
  border: 1px solid var(--line);
  padding: 2px 6px;
  border-radius: 4px;
  font-family: var(--mono);
  font-size: 0.88em;
  color: var(--ink);
}
.lab-code-box {
  margin: 2em 0;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid #334155;
  background: #0f172a;
}
.lab-code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 9px 16px;
  background: #1e293b;
  border-bottom: 1px solid #334155;
  font-family: var(--mono);
  font-size: 11.5px;
  color: #94a3b8;
}
.lab-copy-btn {
  background: transparent;
  border: 1px solid #475569;
  color: #e2e8f0;
  border-radius: 4px;
  padding: 3px 10px;
  font-size: 11px;
  font-family: var(--mono);
  cursor: pointer;
  transition: all 0.15s;
}
.lab-copy-btn:hover {
  background: #334155;
  border-color: #64748b;
}
.lab-copy-btn.copied {
  background: #10b981;
  border-color: #10b981;
  color: #ffffff;
}
.lab-body pre {
  margin: 0 !important;
  border: none !important;
  border-radius: 0 !important;
  background: #0f172a !important;
  padding: 18px 20px !important;
  overflow-x: auto;
}
.lab-body pre code {
  font-family: var(--mono);
  font-size: 13.5px;
  line-height: 1.65;
  color: #e2e8f0;
  background: transparent !important;
  padding: 0 !important;
}

/* ── Minimal Kmong Banner ────────────────────────── */
.kmong-cta-box {
  background: var(--bg-soft);
  border: 1px solid var(--line-s);
  border-radius: 8px;
  padding: 28px 32px;
  margin: 48px 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.kmong-cta-eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}
.kmong-cta-title {
  font-family: var(--sans);
  font-size: 19px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}
.kmong-cta-desc {
  font-size: 14.5px;
  color: var(--ink-2);
  line-height: 1.7;
}
.kmong-cta-btn {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--ink);
  color: var(--bg-elev);
  padding: 9px 18px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  text-decoration: none !important;
  transition: opacity 0.2s;
  margin-top: 4px;
}
.kmong-cta-btn:hover {
  opacity: 0.85;
}

/* ── Curated Recommendations ─────────────────────── */
.rec-section {
  border-top: 1px solid var(--line);
  padding-top: 40px;
  margin-top: 56px;
}
.rec-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24px;
}
.rec-heading {
  font-family: var(--sans);
  font-size: 18px;
  font-weight: 600;
  color: var(--ink);
}
.rec-sub {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.12em;
  color: var(--muted);
  text-transform: uppercase;
}
.rec-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 32px;
}
.rec-card {
  background: var(--bg-elev);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  text-decoration: none !important;
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
}
.rec-card:hover {
  border-color: var(--line-s);
  box-shadow: 0 6px 20px rgba(0,0,0,0.04);
  transform: translateY(-2px);
}
.rec-badge {
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 8px;
}
.rec-card-title {
  font-family: var(--sans);
  font-size: 15px;
  font-weight: 600;
  line-height: 1.4;
  color: var(--ink);
  margin-bottom: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.rec-card-desc {
  font-size: 12.5px;
  line-height: 1.6;
  color: var(--ink-2);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12px;
}
.rec-arrow {
  font-size: 12px;
  font-weight: 500;
  color: var(--ink);
  margin-top: auto;
}

.home-jump-btn {
  display: flex;
  justify-content: center;
  margin-top: 12px;
}
.home-jump-btn a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13.5px;
  font-weight: 500;
  color: var(--ink);
  background: var(--bg-soft);
  border: 1px solid var(--line-s);
  padding: 10px 22px;
  border-radius: 24px;
  text-decoration: none !important;
  transition: all 0.2s;
}
.home-jump-btn a:hover {
  background: var(--ink);
  color: var(--bg-elev);
}

@media (max-width: 768px) {
  .lab-wrap { padding: 36px 18px 64px; }
  .kmong-cta-box { padding: 22px; }
  .kmong-cta-btn { width: 100%; justify-content: center; }
  .rec-grid { grid-template-columns: 1fr; }
}
</style>

<div class="lab-wrap">
  <!-- 상단 네비게이션 -->
  <div class="lab-nav-bar">
    <a href="/" class="lab-back-link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      <span>dadanote 홈으로</span>
    </a>
    <span class="lab-category-tag">{post.data.categoryBadge || 'twonelab 연구소'}</span>
  </div>

  <!-- 헤더 -->
  <header class="lab-header">
    <h1 class="lab-title">{post.data.title}</h1>
    <p class="lab-lead">{post.data.summary}</p>
    <div class="lab-meta">
      배포일: {formattedDate}
    </div>
  </header>

  <!-- 본문 -->
  <article class="lab-body">
    <Content />
  </article>

  <!-- 크몽 솔루션 배너 -->
  <div class="kmong-cta-box">
    <div class="kmong-cta-eyebrow">{ctaEyebrow}</div>
    <h3 class="kmong-cta-title">{ctaTitle}</h3>
    <p class="kmong-cta-desc">{ctaDesc}</p>
    <a href={ctaUrl} target="_blank" rel="noopener noreferrer" class="kmong-cta-btn">
      {ctaBtnText}
    </a>
  </div>

  <!-- 맞춤 큐레이션 추천 섹션 -->
  <section class="rec-section">
    <div class="rec-header">
      <h3 class="rec-heading">{sectionTitle}</h3>
      <span class="rec-sub">CURATED</span>
    </div>

    <div class="rec-grid">
      {recommendedItems.map(item => (
        <a href={item.url} class="rec-card">
          <div>
            <div class="rec-badge">{item.badge}</div>
            <h4 class="rec-card-title">{item.title}</h4>
            <p class="rec-card-desc">{item.summary}</p>
          </div>
          <span class="rec-arrow">글 읽어보기 →</span>
        </a>
      ))}
    </div>

    <div class="home-jump-btn">
      <a href="/">
        <span>dadanote 전체 엔지니어링 글 둘러보기</span>
        <span>→</span>
      </a>
    </div>
  </section>
</div>

<!-- 원클릭 복사 스크립트 -->
<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const codeBlocks = document.querySelectorAll('.lab-body pre');
  codeBlocks.forEach((pre) => {
    // 래퍼 컨테이너 생성
    const wrapper = document.createElement('div');
    wrapper.className = 'lab-code-box';

    // 헤더 바 생성
    const header = document.createElement('div');
    header.className = 'lab-code-header';
    header.innerHTML = `
      <span>TWONELAB CODE</span>
      <button type="button" class="lab-copy-btn">복사하기</button>
    `;

    // pre 요소의 부모 노드에 wrapper 삽입 후 pre 이동
    pre.parentNode.insertBefore(wrapper, pre);
    wrapper.appendChild(header);
    wrapper.appendChild(pre);

    const btn = header.querySelector('.lab-copy-btn');
    btn.addEventListener('click', () => {
      const code = pre.querySelector('code') ? pre.querySelector('code').innerText : pre.innerText;
      navigator.clipboard.writeText(code.trim()).then(() => {
        btn.classList.add('copied');
        btn.innerText = '복사 완료! ✓';
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerText = '복사하기';
        }, 2000);
      });
    });
  });
});
</script>
</Layout>
