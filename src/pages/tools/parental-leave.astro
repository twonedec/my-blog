---
import Layout from '../../layouts/Layout.astro';
import Adsense from '../../components/Adsense.astro';

const pageTitle = "2026 육아휴직 & 단축근무 급여 통합 계산기 — 다다노트";
const pageDesc = "2026년 최신 개정 고용보험 기준 일반 육아휴직(월 최대 250만원·사후지급금 폐지 100% 매월 수령), 6+6 부모육아휴직제(배우자 사용기간 연동 최대 450만원), 육아기 단축근무 정부지원금(주 5~25시간 단축 자유 선택) 및 회사 급여 세후 실수령액을 1초 만에 자동 계산합니다.";
---

<Layout title={pageTitle} description={pageDesc} ogImage="/og/parental-leave.png">
  <div class="calc-page-wrap">
    <!-- Breadcrumb -->
    <nav class="calc-breadcrumb">
      <a href="/">홈</a>
      <span class="sep">/</span>
      <a href="/tools/">계산기</a>
      <span class="sep">/</span>
      <span class="curr">2026 육아휴직 & 단축근무 계산기</span>
    </nav>

    <!-- Header -->
    <header class="calc-header">
      <div class="calc-badge">
        <span class="dot"></span> 2026 고용보험 최신 개정 · 사후지급금 전면 폐지 · 6+6 부모휴직 & 주 5~25시간 단축근무 완벽 반영
      </div>
      <h1 class="calc-title">육아휴직 & 단축근무 급여 계산기</h1>
      <p class="calc-subtitle">
        내 월 통상임금과 조건을 입력하면 <strong>육아휴직 급여(일반 & 6+6 특례 자동 판정)</strong>와 
        <strong>육아기 단축근무 시 정부지원금 + 회사 급여 세후 실수령액</strong>을 즉시 산출해 드립니다.
      </p>
    </header>

    <Adsense />

    <!-- ═════════════════════════════════════════════════════════════
         모드 탭 선택 바 (육아휴직 vs 단축근무 vs 비교)
         ═════════════════════════════════════════════════════════════ -->
    <div class="tabs-nav-wrap">
      <div class="tabs-nav">
        <button type="button" class="tab-item active" data-tab="leave">👶 육아휴직 급여 (일반 & 6+6 통합)</button>
        <button type="button" class="tab-item" data-tab="short">💼 육아기 근로시간 단축</button>
        <button type="button" class="tab-item" data-tab="compare">⚖️ 휴직 vs 단축 수입 비교</button>
      </div>
    </div>

    <!-- ═════════════════════════════════════════════════════════════
         메인 그리드 (입력 패널 + 결과 리포트)
         ═════════════════════════════════════════════════════════════ -->
    <div class="calc-main-grid">
      <!-- 1. 좌측 입력 패널 -->
      <section class="calc-card input-card">
        <div class="panel-header-row">
          <h2 class="panel-section-title">
            <span class="icon">⚙️</span> 급여 및 조건 설정
          </h2>
          <button type="button" id="btn-reset" class="calc-reset-btn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
              <path d="M3 3v5h5"/>
            </svg>
            초기화
          </button>
        </div>

        <div class="input-form">
          <!-- 통상임금 입력 -->
          <div class="form-item">
            <label for="monthly-salary">
              <span>내 월 통상임금 (기본급 + 고정수당) <span class="req">*</span></span>
              <span class="sub-hint">휴직 전 3개월 평균 세전 통상임금</span>
            </label>
            <div class="input-unit-box">
              <input 
                type="text" 
                id="monthly-salary" 
                class="h-input" 
                value="3,500,000" 
                inputmode="numeric"
              />
              <span class="unit">원</span>
            </div>
            <div class="quick-salary-tags">
              <button type="button" class="btn-quick" data-val="2500000">250만</button>
              <button type="button" class="btn-quick" data-val="3000000">300만</button>
              <button type="button" class="btn-quick" data-val="3500000">350만</button>
              <button type="button" class="btn-quick" data-val="4000000">400만</button>
              <button type="button" class="btn-quick" data-val="5000000">500만</button>
            </div>
          </div>

          <!-- [육아휴직 탭 전용] 내 휴직 예정 기간 -->
          <div class="form-item" id="group-my-months">
            <label>
              <span>내 휴직 예정 기간</span>
              <span class="sub-hint">부모 1인 기본 1년 (부모 모두 3개월 이상 시 1년 6개월 연장)</span>
            </label>
            <div class="seg-group" id="seg-my-months">
              <button type="button" class="seg-btn" data-months="3">3개월</button>
              <button type="button" class="seg-btn" data-months="6">6개월</button>
              <button type="button" class="seg-btn active" data-months="12">12개월 (1년)</button>
              <button type="button" class="seg-btn" data-months="18">18개월 (연장)</button>
            </div>
          </div>

          <!-- [육아휴직 탭 전용] 6+6 부모휴직 옵션 박스 -->
          <div class="spouse-leave-box" id="section-spouse-options">
            <div class="switch-row">
              <div class="switch-label-area">
                <span class="switch-title">👩‍👧‍👦 6+6 부모육아휴직제 적용</span>
                <span class="switch-desc">자녀 생후 18개월 이내이며, 배우자도 함께/순차적으로 육아휴직을 사용함</span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="check-spouse-used" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <!-- 배우자 휴직 개월 수 선택 (체크 시 활성화) -->
            <div class="spouse-months-subpanel" id="spouse-months-subpanel">
              <div class="form-item" style="margin-bottom: 0;">
                <label>
                  <span>배우자의 육아휴직 사용 기간</span>
                  <span class="sub-hint">배우자가 사용한 기간까지만 6+6 특례 상한 적용</span>
                </label>
                <div class="seg-group-sm" id="seg-spouse-months">
                  <button type="button" class="seg-btn-sm" data-smonths="1">1개월</button>
                  <button type="button" class="seg-btn-sm" data-smonths="2">2개월</button>
                  <button type="button" class="seg-btn-sm" data-smonths="3">3개월</button>
                  <button type="button" class="seg-btn-sm" data-smonths="4">4개월</button>
                  <button type="button" class="seg-btn-sm" data-smonths="5">5개월</button>
                  <button type="button" class="seg-btn-sm active" data-smonths="6">6개월 이상</button>
                </div>
                <p class="rule-hint-text" id="six-rule-hint">
                  ℹ️ 배우자가 <strong>6개월 이상</strong> 사용하므로 내 휴직 기간 중 <strong>첫 6개월 전체</strong>에 6+6 특례(월 최대 250만~450만원)가 적용됩니다.
                </p>
              </div>
            </div>
          </div>

          <!-- [단축근무 탭 전용] 단축 근로 시간 정밀 설정 (주 5~25시간 단축, 법정 기준) -->
          <div class="form-item conditional-box" id="section-short-options" style="display:none;">
            <label>
              <span>주당 단축할 근로 시간 선택</span>
              <span class="sub-hint">법정 기준: 주 5시간 ~ 최대 25시간 단축 (단축 후 주 15~35시간 근무)</span>
            </label>
            
            <!-- 단축 시간 선택 칩 -->
            <div class="short-hours-chip-grid" id="seg-short-weekly-chips">
              <button type="button" class="chip-btn" data-whours="5">주 5h 단축 (하루 1h)</button>
              <button type="button" class="chip-btn active" data-whours="10">주 10h 단축 (하루 2h)</button>
              <button type="button" class="chip-btn" data-whours="15">주 15h 단축 (하루 3h)</button>
              <button type="button" class="chip-btn" data-whours="20">주 20h 단축 (하루 4h)</button>
              <button type="button" class="chip-btn" data-whours="25">주 25h 단축 (최대)</button>
            </div>

            <!-- 단축근무 상세 배너 -->
            <div class="short-status-badge">
              <div class="ss-row">
                <span>기존 정규 근로: <strong>주 40시간</strong></span>
                <span>➔ 단축 후 근로: <strong id="worked-hours-display" class="text-blue">주 30시간 (하루 6h)</strong></span>
              </div>
              <div class="ss-formula">
                💡 <strong>급여 산정 공식:</strong> 최초 10시간분은 <strong>통상임금 100%(상한 250만)</strong> 지원 + 초과 단축분은 <strong>80%(상한 160만)</strong> 정부 지원!
              </div>
            </div>
          </div>

          <!-- 콜아웃 안내문 -->
          <div class="info-callout" id="callout-notice">
            <strong>💡 2026 핵심 개정 안내:</strong><br>
            복직 6개월 후 돌려받던 <strong>사후지급금(25%)이 전면 폐지</strong>되어, 휴직 기간 동안 전액 100% 매월 즉시 통장에 입금됩니다!
          </div>

          <div class="info-callout short-callout" id="callout-short" style="display:none;">
            <strong>💼 단축 급여 수령 안내:</strong><br>
            <strong>정부 지원금</strong>은 고용보험법에 따른 비과세 100% 실수령액입니다. <strong>회사 급여</strong>는 소정근로시간 비례치이며, 4대보험/소득세 공제 모드를 선택해 예상 실수령액을 함께 비교할 수 있습니다.
          </div>
        </div>
      </section>

      <!-- 2. 우측 결과 리포트 패널 -->
      <section class="calc-card result-card" id="result-anchor">
        <div class="panel-header-row">
          <h2 class="panel-section-title">
            <span class="icon">📊</span> <span id="report-panel-title">예상 수령액 리포트</span>
          </h2>
        </div>

        <!-- 히어로 총액 배너 -->
        <div class="res-hero-box">
          <div class="hero-top-tag" id="summary-title">육아휴직 총 수령액 (12개월)</div>
          <div class="res-hero-amount">
            <span id="total-display" class="hero-number">20,500,000</span>
            <span class="hero-unit">원</span>
          </div>
          <p class="hero-caption" id="summary-sub">
            사후지급금 폐지 100% 전액 매월 통장 즉시 지급
          </p>
        </div>

        <!-- 단축근무 전용: 세전 vs 세후 실수령 브레이크다운 카드 -->
        <div class="short-tax-card" id="short-tax-card" style="display:none;">
          <div class="tax-header-row">
            <span class="tax-card-title">💳 월 실제 통장 입금액 (회사 + 정부)</span>
            <div class="tax-toggle-group">
              <button type="button" id="btn-tax-net" class="tax-btn active">세후(실수령)</button>
              <button type="button" id="btn-tax-gross" class="tax-btn">세전</button>
            </div>
          </div>
          <div class="tax-breakdown-list">
            <div class="tax-row">
              <span class="t-label">• 회사 지급 급여 (<span id="company-tax-label">세후 예상</span>):</span>
              <strong class="t-val" id="company-pay-display">약 2,367,000원</strong>
            </div>
            <div class="tax-row deduct" id="company-deduct-row">
              <span class="t-label">└ 4대보험 & 근로소득세 예상 공제:</span>
              <span class="t-val" id="company-deduct-display">약 -258,000원</span>
            </div>
            <div class="tax-row gov">
              <span class="t-label">• 정부 지원금 (고용보험 비과세 100%):</span>
              <strong class="t-val text-green" id="gov-pay-display">+625,000원</strong>
            </div>
            <div class="tax-row total">
              <span class="t-label">= 매월 실제 통장 입금 총액:</span>
              <strong class="t-val text-primary" id="final-take-home-display">약 2,992,000원 / 월</strong>
            </div>
          </div>

          <!-- 소득 보전율 안내 바 -->
          <div class="retention-bar-wrap">
            <div class="retention-label">
              <span>기존 풀타임 대비 소득 보전율</span>
              <strong id="retention-rate-display" class="text-blue">92.5%</strong>
            </div>
            <div class="retention-track">
              <div class="retention-fill" id="retention-fill" style="width: 92.5%;"></div>
            </div>
          </div>
        </div>

        <!-- 월별 상세 타임라인 (육아휴직 전용) -->
        <div class="timeline-container" id="timeline-container">
          <div class="timeline-header">
            🗓️ 월별 지원금 및 상한액 적용 내역
          </div>
          <div class="timeline-list" id="timeline-list">
            <!-- JS 렌더링 -->
          </div>
        </div>

        <!-- 휴직 vs 단축 비교 테이블 (비교 탭) -->
        <div class="compare-container" id="compare-container" style="display:none;">
          <table class="comp-table">
            <thead>
              <tr>
                <th>구분</th>
                <th>회사 급여</th>
                <th>정부 지원금</th>
                <th style="text-align:right;">월 총 실수령</th>
              </tr>
            </thead>
            <tbody id="compare-body">
              <!-- JS 렌더링 -->
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <!-- ═════════════════════════════════════════════════════════════
         2026 법률 가이드 & 팩트체크 아코디언
         ═════════════════════════════════════════════════════════════ -->
    <section class="calc-guide-section">
      <div class="guide-header">
        <span class="guide-badge">2026 법정 핵심 기준</span>
        <h2 class="guide-main-title">육아휴직 & 단축근무 제도 총정리 가이드</h2>
        <p class="guide-main-desc">
          2025~2026년 대폭 개편된 모성보호 및 고용보험법 최신 개정 내용을 알기 쉽게 정리해 드립니다.
        </p>
      </div>

      <div class="guide-grid">
        <div class="guide-content-card">
          <h3 class="guide-card-title">1. 2026년 육아휴직급여 상한액 개정 및 사후지급금 폐지</h3>
          <p class="guide-card-desc">
            기존 월 150만원에 묶여 있던 일반 육아휴직 상한이 기간별로 대폭 상향되었습니다.
          </p>
          <div class="guide-table-wrap">
            <table class="guide-table">
              <thead>
                <tr>
                  <th>휴직 기간</th>
                  <th>지급률</th>
                  <th>월 상한액</th>
                  <th>월 하한액</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>1~3개월 차</strong></td>
                  <td>통상임금 100%</td>
                  <td><strong>월 최대 250만 원</strong></td>
                  <td>월 70만 원</td>
                </tr>
                <tr>
                  <td><strong>4~6개월 차</strong></td>
                  <td>통상임금 100%</td>
                  <td><strong>월 최대 200만 원</strong></td>
                  <td>월 70만 원</td>
                </tr>
                <tr>
                  <td><strong>7~12개월 차 (이후)</strong></td>
                  <td>통상임금 80%</td>
                  <td><strong>월 최대 160만 원</strong></td>
                  <td>월 70만 원</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="guide-tip-text">
            💡 <strong>사후지급금 폐지:</strong> 종전에는 급여의 25%를 떼어두었다가 복직 후 6개월을 근무해야 지급했으나, 현재는 휴직 기간 중 <strong>매월 100% 전액 입금</strong>됩니다.
          </p>
        </div>

        <div class="guide-content-card">
          <h3 class="guide-card-title">2. '6+6 부모육아휴직제' 특례 적용 원리</h3>
          <p class="guide-card-desc">
            자녀가 생후 18개월 이내일 때 부모가 동시 또는 순차적으로 사용할 경우, <strong>두 부모의 사용 기간 중 겹치는 개월 수(두 번째 사용자의 사용 기간)</strong>만큼 6+6 특례 상한이 적용됩니다.
          </p>
          <ul class="guide-bullet-list">
            <li><strong>1개월 차:</strong> 월 상한 250만 원 (부모 각각)</li>
            <li><strong>2개월 차:</strong> 월 상한 250만 원</li>
            <li><strong>3개월 차:</strong> 월 상한 300만 원</li>
            <li><strong>4개월 차:</strong> 월 상한 350만 원</li>
            <li><strong>5개월 차:</strong> 월 상한 400만 원</li>
            <li><strong>6개월 차:</strong> <strong>월 상한 450만 원</strong></li>
            <li>⚠️ <strong>주의:</strong> 배우자가 3개월만 휴직했다면, 내가 6개월을 휴직하더라도 <strong>첫 3개월까지만 6+6 특례</strong>를 받고, 4~6개월차는 일반 상한(월 200만원)이 적용됩니다.</li>
          </ul>
        </div>

        <div class="guide-content-card">
          <h3 class="guide-card-title">3. 육아기 근로시간 단축 급여 및 소득 보전 (주 5~25시간)</h3>
          <p class="guide-card-desc">
            전일 휴직 대신 일하면서 돌봄을 병행하는 경우, 단축된 시간에 대해 고용보험에서 보조금을 지급합니다.
          </p>
          <ul class="guide-bullet-list">
            <li><strong>단축 허용 범위:</strong> 주당 5시간 단축부터 최대 25시간 단축(단축 후 주 15~35시간 근로)까지 가능</li>
            <li><strong>최초 단축 10시간:</strong> <strong>통상임금 100% 기준 (월 상한 250만 원 한도)</strong>으로 전액 지원</li>
            <li><strong>초과 단축 시간:</strong> <strong>통상임금 80% 기준 (월 상한 160만 원 한도)</strong>으로 지원</li>
            <li><strong>소득 보전율:</strong> 일한 시간만큼은 회사에서 기본 급여를 수령하므로, 하루 2시간 단축(주 30h) 시 통상임금의 <strong>90~95% 수준</strong> 실수령액이 유지됩니다.</li>
