</style>

<script is:inline>
  // 상태 변수
  let currentTab = 'leave'; // 'leave', 'short', 'compare'
  let myLeaveMonths = 12; // 내 휴직 기간 (3, 6, 12, 18)
  let spouseLeaveUsed = true; // 배우자 6+6 사용 여부
  let spouseLeaveMonths = 6; // 배우자 휴직 개월 수 (1~6)
  let weeklyReduceHours = 10; // 주당 단축 시간 (5, 10, 15, 20, 25)
  let taxMode = 'net'; // 'net' or 'gross'

  // 엘리먼트 참조
  const monthlySalaryInput = document.getElementById('monthly-salary');
  const btnReset = document.getElementById('btn-reset');
  const tabButtons = document.querySelectorAll('.tab-item');
  const quickSalaryBtns = document.querySelectorAll('.btn-quick');
  const myMonthBtns = document.querySelectorAll('#seg-my-months .seg-btn');
  const spouseMonthBtns = document.querySelectorAll('#seg-spouse-months .seg-btn-sm');
  const checkSpouseUsed = document.getElementById('check-spouse-used');
  const spouseMonthsSubpanel = document.getElementById('spouse-months-subpanel');
  const spouseLeaveBox = document.getElementById('section-spouse-options');
  const sixRuleHint = document.getElementById('six-rule-hint');

  const sectionSpouseOptions = document.getElementById('section-spouse-options');
  const sectionShortOptions = document.getElementById('section-short-options');
  const groupMyMonths = document.getElementById('group-my-months');
  const shortWeeklyChips = document.querySelectorAll('#seg-short-weekly-chips .chip-btn');
  const workedHoursDisplay = document.getElementById('worked-hours-display');

  const calloutNotice = document.getElementById('callout-notice');
  const calloutShort = document.getElementById('callout-short');
  const shortTaxCard = document.getElementById('short-tax-card');
  const timelineContainer = document.getElementById('timeline-container');
  const compareContainer = document.getElementById('compare-container');

  const btnTaxNet = document.getElementById('btn-tax-net');
  const btnTaxGross = document.getElementById('btn-tax-gross');

  const reportPanelTitle = document.getElementById('report-panel-title');
  const summaryTitle = document.getElementById('summary-title');
  const totalDisplay = document.getElementById('total-display');
  const summarySub = document.getElementById('summary-sub');
  const timelineList = document.getElementById('timeline-list');
  const compareBody = document.getElementById('compare-body');

  const companyPayDisplay = document.getElementById('company-pay-display');
  const companyDeductDisplay = document.getElementById('company-deduct-display');
  const companyDeductRow = document.getElementById('company-deduct-row');
  const companyTaxLabel = document.getElementById('company-tax-label');
  const govPayDisplay = document.getElementById('gov-pay-display');
  const finalTakeHomeDisplay = document.getElementById('final-take-home-display');
  const retentionRateDisplay = document.getElementById('retention-rate-display');
  const retentionFill = document.getElementById('retention-fill');

  // 금액 취득
  function getSalary() {
    const raw = monthlySalaryInput.value.replace(/[^0-9]/g, '');
    return parseInt(raw, 10) || 0;
  }

  function setFormattedSalary(val) {
    monthlySalaryInput.value = parseInt(val, 10).toLocaleString('ko-KR');
    calculate();
  }

  // 4대보험 & 소득세 예상 공제액 간이 계산
  function estimateDeductions(gross) {
    if (gross <= 0) return { totalDeduct: 0, netPay: 0 };
    const pension = Math.round(Math.min(gross, 6170000) * 0.045);
    const health = Math.round(gross * 0.03545);
    const care = Math.round(health * 0.1295);
    const employ = Math.round(gross * 0.009);
    const insurTotal = pension + health + care + employ;

    let incomeTax = 0;
    if (gross > 1060000) {
      if (gross <= 2000000) incomeTax = Math.round((gross - 1060000) * 0.02);
      else if (gross <= 3000000) incomeTax = Math.round(18800 + (gross - 2000000) * 0.035);
      else if (gross <= 4000000) incomeTax = Math.round(53800 + (gross - 3000000) * 0.06);
      else incomeTax = Math.round(113800 + (gross - 4000000) * 0.12);
    }
    const totalTax = Math.round(incomeTax * 1.1); // 지방소득세 10%
    const totalDeduct = insurTotal + totalTax;
    return { totalDeduct, netPay: Math.max(0, gross - totalDeduct) };
  }

  // 힌트 텍스트 업데이트
  function updateSpouseHint() {
    if (!spouseLeaveUsed) {
      sixRuleHint.textContent = `ℹ️ 배우자 미사용으로 일반 육아휴직 상한(1~3개월 250만, 4~6개월 200만, 7개월 이후 160만)이 적용됩니다.`;
      return;
    }
    const effectiveMonths = Math.min(myLeaveMonths, spouseLeaveMonths, 6);
    if (effectiveMonths < myLeaveMonths && myLeaveMonths <= 6) {
      sixRuleHint.innerHTML = `ℹ️ 배우자가 <strong>${spouseLeaveMonths}개월</strong> 사용하므로, 내 휴직 중 <strong>1~${effectiveMonths}개월차</strong>만 6+6 특례 상한이 적용되고 <strong>${effectiveMonths + 1}~${myLeaveMonths}개월차</strong>는 일반 상한(월 200만원)이 적용됩니다.`;
    } else {
      sixRuleHint.innerHTML = `ℹ️ 배우자가 <strong>${spouseLeaveMonths}개월</strong> 사용하므로 내 휴직 중 <strong>첫 ${effectiveMonths}개월</strong>에 6+6 단계적 특례 상한(최대 450만원)이 적용됩니다.`;
    }
  }

  // 메인 계산 실행
  function calculate() {
    const salary = getSalary();

    if (currentTab === 'leave') {
      calcParentalLeave(salary);
    } else if (currentTab === 'short') {
      calcShortWork(salary);
    } else if (currentTab === 'compare') {
      calcCompare(salary);
    }
  }

  // 1. 육아휴직 급여 계산 (일반 & 6+6 통합 판정)
  function calcParentalLeave(salary) {
    let total = 0;
    const rows = [];
    const sixCaps = [2500000, 2500000, 3000000, 3500000, 4000000, 4500000];
    
    // 6+6 특례가 적용되는 개월 수 = min(내 기간, 배우자 기간, 6)
    const effectiveSixMonths = spouseLeaveUsed ? Math.min(myLeaveMonths, spouseLeaveMonths, 6) : 0;

    for (let m = 1; m <= myLeaveMonths; m++) {
      let maxCap = 1600000;
      let rate = 0.8;
      let tag = '통상 80%';
      let tagClass = '';

      if (spouseLeaveUsed && m <= effectiveSixMonths) {
        // 6+6 부모휴직 특례 적용 구간 (100% 지급, 단계별 상한)
        maxCap = sixCaps[m - 1];
        rate = 1.0;
        tag = `6+6 특례 ${m}개월차 (상한 ${maxCap / 10000}만)`;
        tagClass = 'tag-bonus';
      } else {
        // 일반 육아휴직 기준 적용 구간
        if (m <= 3) {
          maxCap = 2500000;
          rate = 1.0;
          tag = '1~3개월 일반 (상한 250만)';
          tagClass = 'tag-high';
        } else if (m <= 6) {
          maxCap = 2000000;
          rate = 1.0;
          tag = (spouseLeaveUsed && m > effectiveSixMonths) 
            ? `배우자 기간 초과 (일반 상한 200만)` 
            : '4~6개월 일반 (상한 200만)';
          tagClass = 'tag-high';
        } else {
          maxCap = 1600000;
          rate = 0.8;
          tag = '7개월 이후 (상한 160만)';
        }
      }

      let calculated = Math.round(salary * rate);
      let actual = Math.min(Math.max(calculated, 700000), maxCap);
      total += actual;

      rows.push({ month: m, actual, tag, tagClass });
    }

    reportPanelTitle.textContent = '육아휴직 예상 수령액 리포트';
    const typeStr = spouseLeaveUsed ? `6+6 부모휴직 (${effectiveSixMonths}개월 적용)` : '일반 육아휴직';
    summaryTitle.textContent = `${typeStr} 총 예상 수령액 (${myLeaveMonths}개월)`;
    totalDisplay.textContent = total.toLocaleString('ko-KR');
    summarySub.textContent = `월 평균 약 ${Math.round(total / myLeaveMonths).toLocaleString('ko-KR')}원 입금 (사후지급금 폐지 100% 매월 전액 수령)`;

    renderTimeline(rows);
  }

  // 2. 육아기 근로시간 단축 급여 (기간 무관, 월 단위 수령액 명확 산출)
  function calcShortWork(salary) {
    const workedHours = 40 - weeklyReduceHours; // 단축 후 주당 근무시간 (예: 40 - 10 = 30시간)
    workedHoursDisplay.textContent = `주 ${workedHours}시간 (하루 ${workedHours / 5}h)`;

    // 회사 지급 월급 = 통상임금 x (단축 후 근무시간 / 40)
    const companyGross = Math.round(salary * (workedHours / 40));
    const { totalDeduct, netPay: companyNet } = estimateDeductions(companyGross);
    const companyActual = (taxMode === 'net') ? companyNet : companyGross;

    // 정부 지원금 계산 (2026 최신 고용보험법 기준):
    // ① 최초 10시간분: 통상임금 100%(월 상한 250만) x (단축시간 중 최대 10h / 40)
    const first10Hours = Math.min(weeklyReduceHours, 10);
    const capFirst10 = Math.min(salary, 2500000);
    const govFirst10 = Math.round(capFirst10 * (first10Hours / 40));

    // ② 초과 단축분(10시간 초과~25시간): 통상임금 80%(월 상한 160만) x (초과시간 / 40)
    let govExcess = 0;
    if (weeklyReduceHours > 10) {
      const excessHours = weeklyReduceHours - 10;
      const capExcess = Math.min(Math.round(salary * 0.8), 1600000);
      govExcess = Math.round(capExcess * (excessHours / 40));
    }

    const govTotalMonth = govFirst10 + govExcess;
    const totalTakeHomeMonth = companyActual + govTotalMonth;

    // 기존 풀타임 근무 시 예상 세후 실수령액 대비 보전율
    const { netPay: originalNet } = estimateDeductions(salary);
    const retentionRate = originalNet > 0 ? ((totalTakeHomeMonth / originalNet) * 100).toFixed(1) : '100.0';

    reportPanelTitle.textContent = '단축근무 월 급여 & 정부지원 리포트';
    summaryTitle.textContent = `월 최종 통장 입금액 (회사 급여 + 정부 지원금)`;
    totalDisplay.textContent = `${totalTakeHomeMonth.toLocaleString('ko-KR')}`;
    summarySub.textContent = `회사 ${taxMode === 'net' ? '세후' : '세전'} 약 ${companyActual.toLocaleString('ko-KR')}원 + 정부 비과세 지원금 ${govTotalMonth.toLocaleString('ko-KR')}원`;

    companyPayDisplay.textContent = `약 ${companyActual.toLocaleString('ko-KR')}원`;
    companyDeductDisplay.textContent = `약 -${totalDeduct.toLocaleString('ko-KR')}원`;
    govPayDisplay.textContent = `+${govTotalMonth.toLocaleString('ko-KR')}원`;
    finalTakeHomeDisplay.textContent = `약 ${totalTakeHomeMonth.toLocaleString('ko-KR')}원 / 월`;

    retentionRateDisplay.textContent = `${retentionRate}%`;
    retentionFill.style.width = `${Math.min(parseFloat(retentionRate), 100)}%`;
  }

  // 3. 휴직 vs 단축 비교
  function calcCompare(salary) {
    const leaveEarly = Math.min(salary, 2500000);
    const leaveMid = Math.min(salary, 2000000);
    const leaveLate = Math.min(Math.round(salary * 0.8), 1600000);

    const workedHours = 40 - weeklyReduceHours;
    const companyGross = Math.round(salary * (workedHours / 40));
    const first10Hours = Math.min(weeklyReduceHours, 10);
    const govFirst10 = Math.round(Math.min(salary, 2500000) * (first10Hours / 40));
    const excessHours = Math.max(0, weeklyReduceHours - 10);
    const govExcess = Math.round(Math.min(Math.round(salary * 0.8), 1600000) * (excessHours / 40));
    const govTotalMonth = govFirst10 + govExcess;
    const shortTotalMonth = companyGross + govTotalMonth;

    const leave1Year = (leaveEarly * 3) + (leaveMid * 3) + (leaveLate * 6);
    const short1Year = shortTotalMonth * 12;
    const diff = short1Year - leave1Year;

    reportPanelTitle.textContent = '휴직 vs 단축 수입 비교 리포트';
    summaryTitle.textContent = `1년 기준 수입 차이 (단축근무 vs 일반휴직)`;
    totalDisplay.textContent = `+${diff.toLocaleString('ko-KR')}`;
    summarySub.textContent = `주 ${weeklyReduceHours}시간 단축근무 선택 시 전일 휴직 대비 연간 약 ${Math.round(diff/10000)}만원 수입 증가 (회사 세전 예상치 포함)`;

    compareBody.innerHTML = `
      <tr>
        <td><strong>전일 육아휴직 (1~3개월)</strong></td>
        <td class="amount" style="color:var(--muted);">-</td>
        <td class="amount" style="color:#2563eb;">${leaveEarly.toLocaleString('ko-KR')}원</td>
        <td class="amount" style="color:#2563eb;">${leaveEarly.toLocaleString('ko-KR')}원</td>
      </tr>
      <tr>
        <td><strong>전일 육아휴직 (4~6개월)</strong></td>
        <td class="amount" style="color:var(--muted);">-</td>
        <td class="amount" style="color:#2563eb;">${leaveMid.toLocaleString('ko-KR')}원</td>
        <td class="amount" style="color:#2563eb;">${leaveMid.toLocaleString('ko-KR')}원</td>
      </tr>
      <tr>
        <td><strong>전일 육아휴직 (7~12개월)</strong></td>
        <td class="amount" style="color:var(--muted);">-</td>
        <td class="amount" style="color:#2563eb;">${leaveLate.toLocaleString('ko-KR')}원</td>
        <td class="amount" style="color:#2563eb;">${leaveLate.toLocaleString('ko-KR')}원</td>
      </tr>
      <tr class="highlight-row">
        <td><strong>육아기 단축근무 (주 ${weeklyReduceHours}h 단축)</strong></td>
        <td class="amount" style="color:var(--muted);">약 ${companyGross.toLocaleString('ko-KR')}원 <span style="font-size:11px; color:#d97706;">(세전)</span></td>
        <td class="amount" style="color:#059669;">${govTotalMonth.toLocaleString('ko-KR')}원 <span style="font-size:11px; color:#10b981;">(확정)</span></td>
        <td class="amount" style="color:#059669; font-weight:800;">약 ${shortTotalMonth.toLocaleString('ko-KR')}원</td>
      </tr>
      <tr style="background:var(--bg-soft); font-weight:700;">
        <td><strong>1년 총 수입 차이</strong></td>
        <td colspan="2" style="font-size:12px; color:var(--muted);">전일휴직 ${Math.round(leave1Year/10000)}만 vs 단축 약 ${Math.round(short1Year/10000)}만</td>
        <td class="amount" style="color:#059669; font-size:15px;">+약 ${diff.toLocaleString('ko-KR')}원 이득</td>
      </tr>
    `;
  }

  function renderTimeline(rows) {
    timelineList.innerHTML = '';
    rows.forEach(r => {
      const item = document.createElement('div');
      item.className = 'timeline-item';
      item.innerHTML = `
        <div class="timeline-month">
          <span>${r.month}개월차</span>
          <span class="timeline-tag ${r.tagClass}">${r.tag}</span>
        </div>
        <div class="timeline-val">${r.actual.toLocaleString('ko-KR')}원</div>
      `;
      timelineList.appendChild(item);
    });
  }

  // 탭 변경
  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tabButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentTab = btn.getAttribute('data-tab');

      const isLeave = (currentTab === 'leave');
      const isShort = (currentTab === 'short');
      const isCompare = (currentTab === 'compare');

      sectionSpouseOptions.style.display = isLeave ? 'block' : 'none';
      groupMyMonths.style.display = isLeave ? 'block' : 'none';
      sectionShortOptions.style.display = (isShort || isCompare) ? 'block' : 'none';
      calloutNotice.style.display = isLeave ? 'block' : 'none';
      calloutShort.style.display = isShort ? 'block' : 'none';
      shortTaxCard.style.display = isShort ? 'block' : 'none';

      timelineContainer.style.display = isLeave ? 'block' : 'none';
      compareContainer.style.display = isCompare ? 'block' : 'none';

      calculate();
    });
  });

  // 배우자 6+6 토글
  checkSpouseUsed.addEventListener('change', (e) => {
    spouseLeaveUsed = e.target.checked;
    spouseMonthsSubpanel.style.display = spouseLeaveUsed ? 'block' : 'none';
    spouseLeaveBox.classList.toggle('active', spouseLeaveUsed);
    updateSpouseHint();
    calculate();
  });

  // 배우자 개월 수 버튼
  spouseMonthBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      spouseMonthBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      spouseLeaveMonths = parseInt(btn.getAttribute('data-smonths'), 10);
      updateSpouseHint();
      calculate();
    });
  });

  // 금액 입력 리스너
  monthlySalaryInput.addEventListener('input', (e) => {
    let v = e.target.value.replace(/[^0-9]/g, '');
    if (!v) v = '0';
    e.target.value = parseInt(v, 10).toLocaleString('ko-KR');
    calculate();
  });

  // 퀵 버튼
  quickSalaryBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-val');
      setFormattedSalary(val);
    });
  });

  // 내 개월 수 버튼 (휴직 탭)
  myMonthBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      myMonthBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      myLeaveMonths = parseInt(btn.getAttribute('data-months'), 10);
      updateSpouseHint();
      calculate();
    });
  });

  // 단축 시간 칩 (단축근무 탭: 주 5~25시간)
  shortWeeklyChips.forEach(btn => {
    btn.addEventListener('click', () => {
      shortWeeklyChips.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      weeklyReduceHours = parseInt(btn.getAttribute('data-whours'), 10);
      calculate();
    });
  });

  // 세전/세후 모드 토글
  btnTaxNet.addEventListener('click', () => {
    taxMode = 'net';
    btnTaxNet.classList.add('active');
    btnTaxGross.classList.remove('active');
    companyTaxLabel.textContent = '세후 예상';
    companyDeductRow.style.display = 'flex';
    calculate();
  });
  btnTaxGross.addEventListener('click', () => {
    taxMode = 'gross';
    btnTaxGross.classList.add('active');
    btnTaxNet.classList.remove('active');
    companyTaxLabel.textContent = '세전';
    companyDeductRow.style.display = 'none';
    calculate();
  });

  // 리셋 버튼
  btnReset.addEventListener('click', () => {
    setFormattedSalary(3500000);
  });

  // 초기 상태 세팅
  spouseLeaveBox.classList.add('active');
  updateSpouseHint();
  calculate();
</script>
