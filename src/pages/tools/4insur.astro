<script>
// ─────────────────────────────────────────────────────────────
// 2026 4대보험 & 실수령액 계산 엔진
// ─────────────────────────────────────────────────────────────

const salaryInput = document.getElementById('monthly-salary') as HTMLInputElement;
const mealCheck = document.getElementById('taxfree-meal-check') as HTMLInputElement;
const familySelect = document.getElementById('family-count') as HTMLSelectElement;
const childSelect = document.getElementById('child-count') as HTMLSelectElement;
const parentalCheck = document.getElementById('parental-leave-check') as HTMLInputElement;
const leaveMonthsSelect = document.getElementById('leave-months') as HTMLSelectElement;
const parentalOptions = document.getElementById('parental-leave-options');
const parentalNotice = document.getElementById('parental-leave-notice');
const resetBtn = document.getElementById('btn-reset');
const copyBtn = document.getElementById('btn-copy-result');
const copyToast = document.getElementById('copy-toast');

// Result elements
const resNet = document.getElementById('res-net-salary');
const resGross = document.getElementById('res-gross-salary');
const resTotalDed = document.getElementById('res-total-deduction');
const bannerDeductAmt = document.getElementById('banner-deduct-amt');

// Gauges
const gaugeNet = document.getElementById('gauge-net');
const gaugeInsur = document.getElementById('gauge-insur');
const gaugeTax = document.getElementById('gauge-tax');
const pctNet = document.getElementById('pct-net');
const pctInsur = document.getElementById('pct-insur');
const pctTax = document.getElementById('pct-tax');

// Breakdown elements
const amtPension = document.getElementById('amt-pension');
const amtHealth = document.getElementById('amt-health');
const amtCare = document.getElementById('amt-care');
const amtEmploy = document.getElementById('amt-employ');
const amtInsurTotal = document.getElementById('amt-insur-total');
const amtIncomeTax = document.getElementById('amt-income-tax');
const amtLocalTax = document.getElementById('amt-local-tax');

// Employer Breakdown
const amtEmpPension = document.getElementById('amt-emp-pension');
const amtEmpHealth = document.getElementById('amt-emp-health');
const amtEmpCare = document.getElementById('amt-emp-care');
const amtEmpEmploy = document.getElementById('amt-emp-employ');
const amtEmpAccident = document.getElementById('amt-emp-accident');
const amtEmpTotal = document.getElementById('amt-emp-total');
const amtGrandCost = document.getElementById('amt-grand-cost');

// Parental Leave
const pDiscountAmt = document.getElementById('p-discount-amt');
const pMonthlyAmt = document.getElementById('p-monthly-amt');
const pFinalNet = document.getElementById('p-final-net');

// Tab toggles in accordion
const tabEmployee = document.getElementById('tab-btn-employee');
const tabEmployer = document.getElementById('tab-btn-employer');
const panelEmployee = document.getElementById('panel-employee');
const panelEmployer = document.getElementById('panel-employer');

tabEmployee?.addEventListener('click', () => {
  tabEmployee.classList.add('active');
  tabEmployer?.classList.remove('active');
  if (panelEmployee) panelEmployee.style.display = 'block';
  if (panelEmployer) panelEmployer.style.display = 'none';
});

tabEmployer?.addEventListener('click', () => {
  tabEmployer.classList.add('active');
  tabEmployee?.classList.remove('active');
  if (panelEmployee) panelEmployee.style.display = 'none';
  if (panelEmployer) panelEmployer.style.display = 'block';
});

// Accordion toggle
const accordion = document.getElementById('detail-accordion');
const accordionBtn = document.getElementById('btn-accordion-toggle');
accordionBtn?.addEventListener('click', () => {
  accordion?.classList.toggle('open');
});

// Mobile scroll trigger
const btnMobileCalc = document.getElementById('btn-mobile-calc-trigger');
const mobileKnowledge = document.getElementById('mobile-knowledge-section');
const resultAnchor = document.getElementById('result-anchor');

btnMobileCalc?.addEventListener('click', () => {
  const target = window.innerWidth <= 860 && mobileKnowledge ? mobileKnowledge : resultAnchor;
  target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

// Format with commas
function fmt(num: number): string {
  return Math.round(num).toLocaleString('ko-KR');
}

function parseNum(str: string): number {
  return parseInt(str.replace(/[^0-9]/g, ''), 10) || 0;
}

// 근로소득 간이세액표 근사 로직 (2026년 기준)
function calculateIncomeTax(taxableMonthly: number, familyCount: number, childCount: number): number {
  if (taxableMonthly <= 1060000) return 0;
  const annualIncome = taxableMonthly * 12;

  let earnedIncomeDeduction = 0;
  if (annualIncome <= 5000000) {
    earnedIncomeDeduction = annualIncome * 0.7;
  } else if (annualIncome <= 15000000) {
    earnedIncomeDeduction = 3500000 + (annualIncome - 5000000) * 0.4;
  } else if (annualIncome <= 45000000) {
    earnedIncomeDeduction = 7500000 + (annualIncome - 15000000) * 0.15;
  } else if (annualIncome <= 100000000) {
    earnedIncomeDeduction = 12000000 + (annualIncome - 45000000) * 0.05;
  } else {
    earnedIncomeDeduction = 14750000 + (annualIncome - 100000000) * 0.02;
  }

  const basicDeduction = familyCount * 1500000;
  const pensionBase = Math.min(Math.max(taxableMonthly, 390000), 6170000);
  const annualPensionDeduction = pensionBase * 0.0475 * 12;
  const specialDeduction = Math.min(annualIncome * 0.08 + 2000000, 25000000);

  const taxBase = Math.max(0, annualIncome - earnedIncomeDeduction - basicDeduction - annualPensionDeduction - specialDeduction);

  let annualTax = 0;
  if (taxBase <= 14000000) {
    annualTax = taxBase * 0.06;
  } else if (taxBase <= 50000000) {
    annualTax = 840000 + (taxBase - 14000000) * 0.15;
  } else if (taxBase <= 88000000) {
    annualTax = 6240000 + (taxBase - 50000000) * 0.24;
  } else if (taxBase <= 150000000) {
    annualTax = 15360000 + (taxBase - 88000000) * 0.35;
  } else {
    annualTax = 37060000 + (taxBase - 150000000) * 0.38;
  }

  let earnedTaxCredit = 0;
  if (annualTax <= 1300000) {
    earnedTaxCredit = Math.min(annualTax * 0.55, 740000);
  } else {
    earnedTaxCredit = Math.min(715000 + (annualTax - 1300000) * 0.30, 660000);
  }

  let childTaxCredit = 0;
  if (childCount === 1) childTaxCredit = 150000;
  else if (childCount === 2) childTaxCredit = 350000;
  else if (childCount >= 3) childTaxCredit = 350000 + (childCount - 2) * 300000;

  const finalAnnualTax = Math.max(0, annualTax - earnedTaxCredit - childTaxCredit);
  return Math.floor((finalAnnualTax / 12) / 10) * 10;
}

function calculate() {
  const grossSalary = parseNum(salaryInput.value);
  const hasMealDeduction = mealCheck.checked;
  const familyCount = parseInt(familySelect.value, 10);
  const childCount = parseInt(childSelect.value, 10);
  const isParental = parentalCheck.checked;
  const leaveMonths = parseInt(leaveMonthsSelect.value, 10);

  const mealAllowance = hasMealDeduction ? 200000 : 0;
  const taxableSalary = Math.max(0, grossSalary - mealAllowance);

  // 1. 국민연금 (2026: 9.5% -> 근로자 4.75%)
  const pensionBase = Math.min(Math.max(taxableSalary, 390000), 6170000);
  const pensionEmployee = Math.floor((pensionBase * 0.0475) / 10) * 10;
  const pensionEmployer = pensionEmployee;

  // 2. 건강보험 (2026: 7.19% -> 근로자 3.595%)
  const healthBase = Math.min(Math.max(taxableSalary, 279266), 119625120);
  const healthEmployee = Math.floor((healthBase * 0.03595) / 10) * 10;
  const healthEmployer = healthEmployee;

  // 3. 노인장기요양보험 (건보료의 13.14%)
  const careEmployee = Math.floor((healthEmployee * 0.1314) / 10) * 10;
  const careEmployer = careEmployee;

  // 4. 고용보험 (근로자 0.9%)
  const employEmployee = Math.floor((taxableSalary * 0.009) / 10) * 10;
  const employEmployer = Math.floor((taxableSalary * 0.0115) / 10) * 10;

  // 5. 산재보험 (회사 전액 부담, 평균 1.47%)
  const accidentEmployer = Math.floor((taxableSalary * 0.0147) / 10) * 10;

  const totalInsurEmployee = pensionEmployee + healthEmployee + careEmployee + employEmployee;
  const totalInsurEmployer = pensionEmployer + healthEmployer + careEmployer + employEmployer + accidentEmployer;

  // 6. 소득세 & 지방소득세
  const incomeTax = calculateIncomeTax(taxableSalary, familyCount, childCount);
  const localTax = Math.floor((incomeTax * 0.1) / 10) * 10;
  const totalTax = incomeTax + localTax;

  const totalDeduction = totalInsurEmployee + totalTax;
  const netSalary = Math.max(0, grossSalary - totalDeduction);
  const totalCompanyCost = grossSalary + totalInsurEmployer;

  // Update Result UI
  if (resNet) resNet.textContent = fmt(netSalary);
  if (resGross) resGross.textContent = fmt(grossSalary) + '원';
  if (resTotalDed) resTotalDed.textContent = '- ' + fmt(totalDeduction) + '원';
  if (bannerDeductAmt) bannerDeductAmt.textContent = fmt(totalDeduction) + '원';

  // Breakdown Table
  if (amtPension) amtPension.textContent = fmt(pensionEmployee);
  if (amtHealth) amtHealth.textContent = fmt(healthEmployee);
  if (amtCare) amtCare.textContent = fmt(careEmployee);
  if (amtEmploy) amtEmploy.textContent = fmt(employEmployee);
  if (amtInsurTotal) amtInsurTotal.textContent = fmt(totalInsurEmployee);
  if (amtIncomeTax) amtIncomeTax.textContent = fmt(incomeTax);
  if (amtLocalTax) amtLocalTax.textContent = fmt(localTax);

  // Employer Table
  if (amtEmpPension) amtEmpPension.textContent = fmt(pensionEmployer);
  if (amtEmpHealth) amtEmpHealth.textContent = fmt(healthEmployer);
  if (amtEmpCare) amtEmpCare.textContent = fmt(careEmployer);
  if (amtEmpEmploy) amtEmpEmploy.textContent = fmt(employEmployer);
  if (amtEmpAccident) amtEmpAccident.textContent = fmt(accidentEmployer);
  if (amtEmpTotal) amtEmpTotal.textContent = fmt(totalInsurEmployer) + '원';
  if (amtGrandCost) amtGrandCost.textContent = fmt(totalCompanyCost) + '원';

  // Proportion Gauge
  const pctNetVal = grossSalary > 0 ? (netSalary / grossSalary) * 100 : 0;
  const pctInsurVal = grossSalary > 0 ? (totalInsurEmployee / grossSalary) * 100 : 0;
  const pctTaxVal = grossSalary > 0 ? (totalTax / grossSalary) * 100 : 0;

  if (gaugeNet) gaugeNet.style.width = pctNetVal.toFixed(1) + '%';
  if (gaugeInsur) gaugeInsur.style.width = pctInsurVal.toFixed(1) + '%';
  if (gaugeTax) gaugeTax.style.width = pctTaxVal.toFixed(1) + '%';

  if (pctNet) pctNet.textContent = pctNetVal.toFixed(1) + '%';
  if (pctInsur) pctInsur.textContent = pctInsurVal.toFixed(1) + '%';
  if (pctTax) pctTax.textContent = pctTaxVal.toFixed(1) + '%';

  // Parental leave logic
  if (isParental) {
    if (parentalOptions) parentalOptions.style.display = 'block';
    if (parentalNotice) parentalNotice.style.display = 'block';

    const totalOriginalHealth = (healthEmployee + careEmployee) * leaveMonths;
    const totalDiscount = Math.floor(totalOriginalHealth * 0.5);
    const remainingToPay = totalOriginalHealth - totalDiscount;
    const monthlyInstallment = Math.floor((remainingToPay / 10) / 10) * 10;
    const adjustedNetSalary = Math.max(0, netSalary - monthlyInstallment);

    if (pDiscountAmt) pDiscountAmt.textContent = fmt(totalDiscount) + '원';
    if (pMonthlyAmt) pMonthlyAmt.textContent = fmt(monthlyInstallment) + '원';
    if (pFinalNet) pFinalNet.textContent = fmt(adjustedNetSalary) + '원';
  } else {
    if (parentalOptions) parentalOptions.style.display = 'none';
    if (parentalNotice) parentalNotice.style.display = 'none';
  }
}

// Event Listeners
salaryInput?.addEventListener('input', (e) => {
  const target = e.target as HTMLInputElement;
  const raw = parseNum(target.value);
  target.value = raw > 0 ? raw.toLocaleString('ko-KR') : '';
  calculate();
});

mealCheck?.addEventListener('change', calculate);
familySelect?.addEventListener('change', calculate);
childSelect?.addEventListener('change', calculate);
parentalCheck?.addEventListener('change', calculate);
leaveMonthsSelect?.addEventListener('change', calculate);

resetBtn?.addEventListener('click', () => {
  if (salaryInput) salaryInput.value = '3,500,000';
  if (mealCheck) mealCheck.checked = true;
  if (familySelect) familySelect.value = '1';
  if (childSelect) childSelect.value = '0';
  if (parentalCheck) parentalCheck.checked = false;
  if (leaveMonthsSelect) leaveMonthsSelect.value = '12';
  calculate();
});

copyBtn?.addEventListener('click', () => {
  const gross = resGross?.textContent || '';
  const net = resNet?.textContent || '';
  const totalDed = resTotalDed?.textContent || '';
  const insurTot = amtInsurTotal?.textContent || '';
  const taxTot = fmt(parseNum(amtIncomeTax?.textContent || '0') + parseNum(amtLocalTax?.textContent || '0'));

  const text = `[다다노트 2026 실수령액 계산 결과]\n• 세전 월급: ${gross}\n• 예상 실수령액: ${net}원\n• 총 공제액: ${totalDed}\n  - 4대보험: ${insurTot}원\n  - 세금(소득세+지방세): ${taxTot}원\n\n👉 계산기 바로가기: https://dadanote.net/tools/4insur/`;

  navigator.clipboard.writeText(text).then(() => {
    if (copyToast) {
      copyToast.style.display = 'inline';
      setTimeout(() => { copyToast.style.display = 'none'; }, 2500);
    }
  });
});

calculate();
</script>
