---
import Layout from '../../layouts/Layout.astro';
import Adsense from '../../components/Adsense.astro';

const pageTitle = "2026 4대보험 & 월급 실수령액 계산기 — 다다노트";
const pageDesc = "2026년 최신 인상 요율(국민연금 9.5%, 건강보험 7.19%)과 비과세 식대 20만 원, 부양가족 공제, 육아휴직 복직자 감면까지 한눈에 계산하는 간편 실수령액 계산기";
---

<Layout title={pageTitle} description={pageDesc} ogImage="/og/4insur.png">
  <div class="calc-page-wrap">
    <!-- Breadcrumb -->
    <nav class="calc-breadcrumb">
      <a href="/">홈</a>
      <span class="sep">/</span>
      <span class="curr">2026 4대보험 & 실수령액 계산기</span>
    </nav>

    <!-- Header -->
    <header class="calc-header">
      <div class="calc-badge">
        <span class="dot"></span> 2026 최신 요율 개정 반영
      </div>
      <h1 class="calc-title">4대보험 & 월급 실수령액 계산기</h1>
      <p class="calc-subtitle">
        계약 월급을 입력하시면 <strong>비과세 식대 20만 원 자동 차감</strong>과 <strong>부양가족 공제</strong>, 
        그리고 <strong>회사 부담금</strong>까지 1초 만에 정확하게 산출해 드립니다.
      </p>
    </header>

    <Adsense />

    <!-- Calculator Grid Layout -->
    <div class="calc-grid">
      <!-- Input Form Card -->
      <section class="calc-card input-card">
        <h2 class="card-title">급여 및 공제 조건 입력</h2>

        <!-- Monthly Salary -->
        <div class="form-group">
          <label for="monthly-salary">
            세전 계약 월급 (지급 총액)
            <span class="req">*</span>
          </label>
          <div class="input-unit-wrap">
            <input 
              type="text" 
              id="monthly-salary" 
              class="calc-input main-input" 
              value="3,500,000" 
              inputmode="numeric" 
              placeholder="예: 3,500,000" 
            />
            <span class="unit">원</span>
          </div>
        </div>

        <!-- Tax Free Meal Allowance -->
        <div class="form-group taxfree-group">
          <label class="checkbox-label" for="taxfree-meal-check">
            <input type="checkbox" id="taxfree-meal-check" checked />
            <span class="check-custom"></span>
            <span class="check-text">
              <strong>식대 20만 원 비과세 적용</strong> (2026년 기준)
            </span>
          </label>
          <p class="field-hint">
            💡 대부분의 직장인은 월급(계약 총액)에 식대 20만 원이 포함되어 있습니다. 체크 시 식대를 뺀 금액으로 4대보험과 세금을 깎아드립니다.
          </p>
        </div>

        <!-- Dependents & Children -->
        <div class="form-row">
          <div class="form-group half">
            <label for="family-count">부양가족 수 (본인 포함)</label>
            <select id="family-count" class="calc-select">
              <option value="1" selected>1명 (본인만)</option>
              <option value="2">2명 (본인 + 1명)</option>
              <option value="3">3명 (본인 + 2명)</option>
              <option value="4">4명 (본인 + 3명)</option>
              <option value="5">5명 이상</option>
            </select>
          </div>
          <div class="form-group half">
            <label for="child-count">8세~20세 자녀 수</label>
            <select id="child-count" class="calc-select">
              <option value="0" selected>0명 (자녀 없음)</option>
              <option value="1">1명</option>
              <option value="2">2명</option>
              <option value="3">3명 이상</option>
            </select>
          </div>
        </div>
        <p class="family-hint">
          💡 <strong>1인 가구</strong> 또는 <strong>맞벌이 부부</strong>는 <code>1명(본인만)</code>을 선택하세요. 배우자가 소득이 없는 <strong>외벌이 부부</strong>는 <code>2명(본인+배우자)</code>, 자녀나 부모님까지 함께 부양한다면 그 인원수만큼 선택하시면 됩니다.
        </p>

        <!-- Maternity / Paternity Leave Simulation Toggle -->
        <div class="special-mode-box">
          <label class="checkbox-label" for="parental-leave-check">
            <input type="checkbox" id="parental-leave-check" />
            <span class="check-custom"></span>
            <span class="check-text special-text">
              <strong>👶 육아휴직 복직자 모의정산 모드</strong> (선택)
            </span>
          </label>
          
          <div id="parental-leave-options" class="parental-options" style="display:none;">
            <p class="special-desc">
              육아휴직 기간 동안 유예된 건강보험료의 <strong>50% 법적 감면</strong> 및 <strong>10회 무이자 분할 납부</strong>를 반영하여 복직 후 실수령액을 시뮬레이션합니다.
            </p>
            <div class="form-group inline-group">
              <label for="leave-months">총 휴직 기간:</label>
              <select id="leave-months" class="calc-select sm-select">
                <option value="6">6개월</option>
                <option value="12" selected>12개월 (1년)</option>
                <option value="18">18개월</option>
                <option value="24">24개월 (2년)</option>
              </select>
            </div>
          </div>
        </div>

        <button type="button" id="btn-reset" class="calc-reset-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
          입력값 초기화
        </button>
      </section>

      <!-- Output Result Card -->
      <section class="calc-card result-card">
        <div class="result-top">
          <span class="res-badge">이번 달 예상 실수령액</span>
          <div class="res-main-amount">
            <span id="res-net-salary" class="amount-number">3,024,180</span>
            <span class="amount-unit">원</span>
          </div>
          <div class="res-sub-row">
            <span>세전 월급 <strong id="res-gross-salary">3,500,000원</strong>에서</span>
            <span class="sep">·</span>
            <span>공제 총액 <strong id="res-total-deduction" class="text-danger">- 475,820원</strong></span>
          </div>
        </div>

        <!-- Parental Leave Notice (Conditional) -->
        <div id="parental-leave-notice" class="parental-notice-card" style="display:none;">
          <div class="p-notice-title">👶 육아휴직 복직 감면 정산 적용</div>
          <div class="p-notice-grid">
            <div>• 50% 법적 감면액: <strong id="p-discount-amt">0원</strong> 절약</div>
            <div>• 10회 분할 납부액: 월 <strong id="p-monthly-amt">0원</strong> 추가 공제</div>
          </div>
          <div class="p-notice-final">
            ➔ 복직 후 10개월간 실수령액: <span id="p-final-net">0원</span>
          </div>
        </div>

        <!-- Proportion Visual Gauge Bar -->
        <div class="gauge-container">
          <div class="gauge-bar">
            <div id="gauge-net" class="gauge-seg seg-net" style="width: 86%;"></div>
            <div id="gauge-insur" class="gauge-seg seg-insur" style="width: 9%;"></div>
            <div id="gauge-tax" class="gauge-seg seg-tax" style="width: 5%;"></div>
          </div>
          <div class="gauge-legend">
            <span class="leg-item"><span class="leg-dot net"></span> 실수령액 (<span id="pct-net">86.4%</span>)</span>
            <span class="leg-item"><span class="leg-dot insur"></span> 4대보험 (<span id="pct-insur">8.9%</span>)</span>
            <span class="leg-item"><span class="leg-dot tax"></span> 세금 (<span id="pct-tax">4.7%</span>)</span>
          </div>
        </div>

        <!-- Tab Toggle: Employee vs Employer -->
        <div class="tab-toggle-wrap">
          <button type="button" id="tab-btn-employee" class="tab-btn active">근로자 공제 상세</button>
          <button type="button" id="tab-btn-employer" class="tab-btn">회사(사업주) 부담금 보기</button>
        </div>

        <!-- Employee Deduction Table -->
        <div id="panel-employee" class="tab-panel">
          <table class="calc-table">
            <thead>
              <tr>
                <th>공제 항목</th>
                <th>2026년 요율</th>
                <th class="text-right">공제 금액</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>국민연금</strong></td>
                <td>4.75% (개정)</td>
                <td class="text-right"><strong id="amt-pension">156,750</strong>원</td>
              </tr>
              <tr>
                <td><strong>건강보험</strong></td>
                <td>3.595% (개정)</td>
                <td class="text-right"><strong id="amt-health">118,630</strong>원</td>
              </tr>
              <tr>
                <td><strong>노인장기요양보험</strong></td>
                <td>건보료의 13.14%</td>
                <td class="text-right"><strong id="amt-care">15,580</strong>원</td>
              </tr>
              <tr>
                <td><strong>고용보험 (실업급여)</strong></td>
                <td>0.9%</td>
                <td class="text-right"><strong id="amt-employ">29,700</strong>원</td>
              </tr>
              <tr class="subtotal-row">
                <td colspan="2">4대보험 합계</td>
                <td class="text-right"><span id="amt-insur-total">320,660</span>원</td>
              </tr>
              <tr>
                <td><strong>근로소득세</strong></td>
                <td>간이세액표 기준</td>
                <td class="text-right"><strong id="amt-income-tax">141,050</strong>원</td>
              </tr>
              <tr>
                <td><strong>지방소득세</strong></td>
                <td>소득세의 10%</td>
                <td class="text-right"><strong id="amt-local-tax">14,100</strong>원</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Employer Breakdown Panel -->
        <div id="panel-employer" class="tab-panel" style="display:none;">
          <div class="employer-info-box">
            <div class="emp-total-stat">
              <span>회사가 나를 위해 추가 부담하는 4대보험</span>
              <strong id="amt-emp-total">344,050원</strong>
            </div>
            <div class="emp-grand-total">
              <span>내 월급에 들어가는 회사의 총 인건비:</span>
              <strong id="amt-grand-cost">3,844,050원</strong>
            </div>
          </div>
          <table class="calc-table">
            <thead>
              <tr>
                <th>회사 부담 항목</th>
                <th>사업주 요율</th>
                <th class="text-right">회사 부담액</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>국민연금 (회사 부담)</td>
                <td>4.75%</td>
                <td class="text-right"><span id="amt-emp-pension">156,750</span>원</td>
              </tr>
              <tr>
                <td>건강보험 (회사 부담)</td>
                <td>3.595%</td>
                <td class="text-right"><span id="amt-emp-health">118,630</span>원</td>
              </tr>
              <tr>
                <td>노인장기요양 (회사 부담)</td>
                <td>건보료의 13.14%</td>
                <td class="text-right"><span id="amt-emp-care">15,580</span>원</td>
              </tr>
              <tr>
                <td>고용보험 (실업+안정개발)</td>
                <td>1.15%</td>
                <td class="text-right"><span id="amt-emp-employ">37,950</span>원</td>
              </tr>
              <tr>
                <td>산재보험 (회사 100%)</td>
                <td>평균 1.47%</td>
                <td class="text-right"><span id="amt-emp-accident">48,510</span>원</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Action Buttons -->
        <div class="card-actions">
          <button type="button" id="btn-copy-result" class="btn-primary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            결과 요약 복사 (카톡 공유용)
          </button>
          <span id="copy-toast" class="copy-toast" style="display:none;">복사되었습니다!</span>
        </div>
      </section>
    </div>

    <Adsense />

    <!-- Explanatory Guide Article -->
    <article class="calc-guide-article">
      <h2>💡 4대보험 계산기 사용 전 알아두면 돈이 되는 핵심 상식</h2>
      
      <div class="guide-item">
        <h3>1. 2026년 4대보험 요율 개정 팩트체크</h3>
        <p>
          2026년부터 국민연금 요율이 종전 9%에서 <strong>9.5%</strong>(근로자 4.75%)로 27년 만에 상향 조정되었으며, 
          건강보험 요율 역시 <strong>7.19%</strong>(근로자 3.595%), 장기요양보험료율은 약 <strong>13.14%</strong>로 각각 인상되었습니다. 
          고용보험(실업급여 0.9%)과 산재보험(회사 100% 부담)은 종전과 동일하게 유지됩니다.
        </p>
      </div>

      <div class="guide-item">
        <h3>2. 비과세 식대 20만 원이 중요한 이유</h3>
        <p>
          세전 계약 월급이 350만 원이더라도, 식대 20만 원이 비과세 처리되면 실제 세금과 4대보험은 <strong>330만 원을 기준</strong>으로 산정됩니다. 
          비과세 식대를 반영하지 않고 계산하면 매달 약 2만~3만 원가량 공제액이 과다 계산되어 실수령액 오차가 발생합니다. 
          다다노트 계산기는 기본적으로 식대 20만 원 비과세를 자동 차감하여 실제 통장 입금액과 완벽히 일치하도록 설계되었습니다.
        </p>
      </div>

      <div class="guide-item">
        <h3>3. 육아휴직 복직자가 첫 달 건보료 폭탄을 피하는 법</h3>
        <p>
          육아휴직 기간에는 국민연금과 고용보험 납부가 유예되며 복직 후에도 소급 징수되지 않습니다. 
          그러나 건강보험료는 휴직 기간 전체 보험료가 복직 시점에 정산됩니다. 
          반드시 <strong>육아휴직 건보료 50% 법적 감면</strong>이 적용되었는지 확인하시고, 
          금액이 클 경우 회사 총무팀에 <strong>최대 10회 무이자 분할 납부</strong>를 요청하셔야 첫 달 실수령액이 깎이는 참사를 막을 수 있습니다.
        </p>
      </div>

      <div class="guide-item">
        <h3>4. 부업(N잡러) 소득이 있을 때의 건보료 기준</h3>
        <p>
          직장에서 받는 월급 외에 블로그 원고료, 스마트스토어, 크몽 외주, 배당·이자 등 
          <strong>'보수 외 소득'이 연간 2,000만 원을 초과</strong>하면 초과분에 대해 
          <strong>'소득월액보험료'</strong>가 추가 고지됩니다. 
          2,000만 원 이하일 경우에는 회사에 통보가 가지 않으며 추가 건보료도 부과되지 않습니다.
        </p>
      </div>
    </article>
  </div>
</Layout>

<style>
/* Page Layout */
.calc-page-wrap {
  max-width: 1060px;
  margin: 0 auto;
  padding: 40px 24px 100px;
}

.calc-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 24px;
}
.calc-breadcrumb a:hover { color: var(--ink); }
.calc-breadcrumb .sep { opacity: .4; }
.calc-breadcrumb .curr { color: var(--ink); font-weight: 600; }

/* Header */
.calc-header { margin-bottom: 32px; }
.calc-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: oklch(0.94 0.03 155);
  color: var(--c-income);
  padding: 4px 12px;
  border-radius: 9999px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .08em;
  margin-bottom: 12px;
}
.calc-badge .dot {
  width: 6px; height: 6px; border-radius: 50%; background: currentColor;
}
.calc-title {
  font-family: var(--serif);
  font-size: clamp(28px, 3.6vw, 40px);
  font-weight: 400;
  line-height: 1.25;
  letter-spacing: -.02em;
  color: var(--ink);
  margin-bottom: 14px;
}
.calc-subtitle {
  font-size: 15px;
  line-height: 1.7;
  color: var(--ink-2);
  max-width: 720px;
}

/* Grid Layout */
.calc-grid {
  display: grid;
  grid-template-columns: minmax(0, 480px) minmax(0, 540px);
  gap: 32px;
  align-items: start;
  margin-bottom: 48px;
}

@media (max-width: 960px) {
  .calc-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}

/* Cards */
.calc-card {
  background: var(--bg-elev);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 28px;
  box-shadow: 0 4px 20px oklch(0.15 0.01 85 / .03);
}

.card-title {
  font-family: var(--sans);
  font-size: 17px;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 24px;
  letter-spacing: -.01em;
}

/* Form Groups */
.form-group {
  margin-bottom: 20px;
}
.form-group label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 8px;
}
.form-group .req { color: #ef4444; }

.input-unit-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.calc-input {
  width: 100%;
  height: 48px;
  padding: 0 40px 0 16px;
  font-family: var(--mono);
  font-size: 18px;
  font-weight: 600;
  color: var(--ink);
  background: var(--bg-soft);
  border: 1px solid var(--line);
  border-radius: 8px;
  outline: none;
  transition: border-color .2s, box-shadow .2s;
}
.calc-input:focus {
  border-color: var(--ink);
  background: #fff;
  box-shadow: 0 0 0 3px oklch(0.20 0.005 270 / .08);
}
.input-unit-wrap .unit {
  position: absolute;
  right: 16px;
  font-size: 14px;
  font-weight: 600;
  color: var(--muted);
  pointer-events: none;
}

/* Checkbox */
.checkbox-label {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  user-select: none;
