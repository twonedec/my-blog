---
import Layout from '../../layouts/Layout.astro';
import Adsense from '../../components/Adsense.astro';

const pageTitle = "2026 4대보험 & 월급 실수령액 계산기 — 다다노트";
const pageDesc = "2026년 최신 인상 요율(국민연금 9.5%, 건강보험 7.19%)과 비과세 식대 20만 원, 부양가족 공제, 육아휴직 복직자 감면까지 한눈에 계산하는 간편 실수령액 계산기";
---

<Layout title={pageTitle} description={pageDesc} ogImage="/og/4insur.png">
  <div class="calc-page-wrap">
    <!-- Breadcrumb -->
    <nav class="calc-breadcrumb">
      <a href="/">홈</a>
      <span class="sep">/</span>
      <a href="/tools/">계산기</a>
      <span class="sep">/</span>
      <span class="curr">2026 4대보험 & 실수령액 계산기</span>
    </nav>

    <!-- Header -->
    <header class="calc-header">
      <div class="calc-badge">
        <span class="dot"></span> 2026 최신 요율 개정 반영 (국민연금 9.5% · 건보 7.19%)
      </div>
      <h1 class="calc-title">4대보험 & 월급 실수령액 계산기</h1>
      <p class="calc-subtitle">
        계약 월급을 입력하시면 <strong>비과세 식대 20만 원 자동 차감</strong>과 <strong>부양가족 공제</strong>, 
        그리고 <strong>회사 부담금</strong>까지 1초 만에 정확하게 산출해 드립니다.
      </p>
    </header>

    <Adsense />

    <!-- ═════════════════════════════════════════════════════════════
         [개선 1] 가로 배치형 컴팩트 입력 패널 (Horizontal Input Bar)
         ═════════════════════════════════════════════════════════════ -->
    <section class="horizontal-input-panel">
      <div class="h-input-grid">
        <!-- Monthly Salary -->
        <div class="form-item">
          <label for="monthly-salary">
            <span>세전 계약 월급 (지급 총액) <span class="req">*</span></span>
            <span class="sub-hint">기본값 350만 원</span>
          </label>
          <div class="input-unit-box">
            <input 
              type="text" 
              id="monthly-salary" 
              class="h-input" 
              value="3,500,000" 
              inputmode="numeric" 
              placeholder="예: 3,500,000" 
            />
            <span class="unit">원</span>
          </div>
        </div>

        <!-- Family count -->
        <div class="form-item">
          <label for="family-count">부양가족 수 (본인 포함)</label>
          <select id="family-count" class="h-select">
            <option value="1" selected>1명 (본인만 / 맞벌이)</option>
            <option value="2">2명 (외벌이 부부)</option>
            <option value="3">3명 (본인 + 2명)</option>
            <option value="4">4명 (본인 + 3명)</option>
            <option value="5">5명 이상</option>
          </select>
        </div>

        <!-- Child count -->
        <div class="form-item">
          <label for="child-count">8세~20세 자녀 수</label>
          <select id="child-count" class="h-select">
            <option value="0" selected>0명 (자녀 없음)</option>
            <option value="1">1명</option>
            <option value="2">2명</option>
            <option value="3">3명 이상</option>
          </select>
        </div>
      </div>

      <!-- Sub Options Row -->
      <div class="h-options-row">
        <label class="checkbox-label" for="taxfree-meal-check">
          <input type="checkbox" id="taxfree-meal-check" checked />
          <span class="custom-check"></span>
          <span><strong>식대 20만 원 비과세 자동 차감</strong> (2026년 기준)</span>
        </label>

        <div class="special-toggle-wrap">
          <label class="checkbox-label" for="parental-leave-check">
            <input type="checkbox" id="parental-leave-check" />
            <span class="custom-check"></span>
            <span class="special-text">👶 육아휴직 복직자 모의정산 모드</span>
          </label>
          <button type="button" id="btn-reset" class="calc-reset-btn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
              <path d="M3 3v5h5"/>
            </svg>
            초기화
          </button>
        </div>
      </div>

      <!-- Parental Leave Options (Conditional) -->
      <div id="parental-leave-options" class="parental-options" style="display:none;">
        <p class="special-desc">
          육아휴직 기간 유예된 건보료의 <strong>50% 법적 감면</strong> 및 <strong>10회 무이자 분할 납부</strong>를 반영하여 복직 후 실수령액을 계산합니다.
        </p>
        <div class="inline-select-group">
          <label for="leave-months">총 휴직 기간:</label>
          <select id="leave-months" class="h-select sm-select">
            <option value="6">6개월</option>
            <option value="12" selected>12개월 (1년)</option>
            <option value="18">18개월</option>
            <option value="24">24개월 (2년)</option>
          </select>
        </div>
      </div>

      <!-- 모바일 전용 결과보기 CTA 버튼 -->
      <div class="mobile-calc-cta-wrap">
        <button type="button" id="btn-mobile-calc-trigger" class="btn-mobile-scroll">
          <span>👇 내 실수령액 결과 확인하기</span>
        </button>
      </div>
    </section>

    <!-- ═════════════════════════════════════════════════════════════
         [개선 2] 하단 분할 대시보드 (메인 결과 68% + 우측 사이드바 32%)
         ═════════════════════════════════════════════════════════════ -->
    <div class="dashboard-split-layout">

      <!-- 좌측 메인 결과 칼럼 -->
      <div class="main-result-col" id="result-anchor">

        <!-- [모바일 전용] 머니 시크릿 리포트 (결과 바로 위에 먼저 노출) -->
        <div class="mobile-knowledge-top-wrap" id="mobile-knowledge-section">
          <div class="m-knowledge-header">
            <span class="m-k-badge">💡 Dadanote Secret Report</span>
            <h2 class="m-k-title">4대보험 떼이고 한숨 나올 때 읽어야 할 머니 시크릿 4선</h2>
          </div>
          
          <div class="k-post-grid">
            <!-- Card 1: 부수입 플랫폼 -->
            <div class="k-post-card">
              <div class="k-post-badge-row">
                <span class="k-category-pill platform">부수입 현실</span>
                <span class="k-fact-tag">공제액 역전 노하우</span>
              </div>
              <h3 class="k-post-hook">"2026년 4대보험 인상으로 깎인 월급, 퇴근 후 어떻게 메울까?"</h3>
              <p class="k-post-fact">국민연금 9.5%, 건강보험 7.19% 인상. 물가와 공제액 인상 속도를 따라잡는 현실적인 퇴근 후 파이프라인.</p>
              <a href="/posts/01-side-income-platforms-guide/" class="k-post-cta-btn">
                <span>[필독] 현실 부수입 4대 플랫폼 비교 읽기</span>
                <span class="arrow">→</span>
              </a>
            </div>

            <!-- Card 2: 부업 세무 & 2,000만원 기준 (Highlight) -->
            <div class="k-post-card highlight">
              <div class="k-post-badge-row">
                <span class="k-category-pill tax">세무 & 건보료</span>
                <span class="k-fact-tag green">회사 통보 0건</span>
              </div>
              <h3 class="k-post-hook">"월급 외 부수입 10만 원만 벌어도 회사에 통보 갈까요?"</h3>
              <p class="k-post-fact">연 2,000만 원 이하 '보수 외 소득'은 <strong>회사 통보 0건 & 건보료 0원</strong>! 3.3% 원천징수와 종소세 자진신고법 완벽 정리.</p>
              <a href="/posts/15-side-income-tax-guide-comprehensive-income/" class="k-post-cta-btn green">
                <span>[단독] 부수입 세무 상식 & 종소세 가이드 읽기</span>
                <span class="arrow">→</span>
              </a>
            </div>

            <!-- Card 3: 시간 관리 루틴 -->
            <div class="k-post-card">
              <div class="k-post-badge-row">
                <span class="k-category-pill routine">시간 관리</span>
                <span class="k-fact-tag">번아웃 극복</span>
              </div>
              <h3 class="k-post-hook">"야근 많은 직장인은 부업할 시간을 어떻게 낼까?"</h3>
              <p class="k-post-fact">의지력 문제가 아닙니다. 평일 1시간 + 주말 2시간 <strong>'주 7시간 블록 타임제'</strong>로 본업 지장 없이 파이프라인을 굴리는 법.</p>
              <a href="/posts/2026-10-01-side-income-time-management/" class="k-post-cta-btn">
                <span>[루틴] 지치지 않는 주 7시간 시간관리법</span>
                <span class="arrow">→</span>
              </a>
            </div>

            <!-- Card 4: 육아휴직 & 아이 성장 계산기 -->
            <div class="k-post-card baby">
              <div class="k-post-badge-row">
                <span class="k-category-pill baby">육아 & 복직</span>
                <span class="k-fact-tag pink">질병청 LMS 공식</span>
              </div>
              <h3 class="k-post-hook">"육아휴직 복직 시 건보료 50% 감면 신청하셨나요?"</h3>
              <p class="k-post-fact">첫 달 건보료 폭탄 방지 분할 납부 팁! 우리 아이 키·몸무게가 또래 100명 중 몇 번째로 큰지도 1초 만에 확인해 보세요.</p>
              <a href="/tools/growth/" class="k-post-cta-btn pink">
                <span>[무료 툴] 아이 키·몸무게 성장 백분위 계산기</span>
                <span class="arrow">→</span>
              </a>
            </div>
          </div>

          <div class="m-transition-arrow">
            <span>위 기준이 적용된 최종 실수령액 결과</span>
            <span class="arrow-bounce">👇</span>
          </div>
        </div>

        <!-- 실수령액 결과 카드 -->
        <section class="result-summary-card">
          <!-- Hero Result -->
          <div class="res-hero-box">
            <span class="res-hero-tag">이번 달 예상 실수령액</span>
            <div class="res-hero-amount">
              <span id="res-net-salary" class="hero-number">3,024,180</span>
              <span class="hero-unit">원</span>
            </div>
            <div class="res-calc-pills">
              <span class="res-pill">세전 월급 <strong id="res-gross-salary">3,500,000원</strong></span>
              <span class="res-pill">공제 총액 <strong id="res-total-deduction" class="text-danger">- 475,820원</strong></span>
            </div>
          </div>

          <!-- Parental Leave Notice (Conditional) -->
          <div id="parental-leave-notice" class="parental-notice-card" style="display:none;">
            <div class="p-notice-title">👶 육아휴직 복직 감면 정산 적용</div>
            <div class="p-notice-grid">
              <div>• 50% 법적 감면액: <strong id="p-discount-amt">0원</strong> 절약</div>
              <div>• 10회 분할 납부: 월 <strong id="p-monthly-amt">0원</strong> 추가 공제</div>
            </div>
            <div class="p-notice-final">
              ➔ 복직 후 10개월간 실수령액: <span id="p-final-net">0원</span>
            </div>
          </div>

          <!-- Proportion Gauge -->
          <div class="gauge-wrapper">
            <div class="gauge-bar-track">
              <div id="gauge-net" class="g-seg g-net" style="width: 86%;"></div>
              <div id="gauge-insur" class="g-seg g-insur" style="width: 9%;"></div>
              <div id="gauge-tax" class="g-seg g-tax" style="width: 5%;"></div>
            </div>
            <div class="gauge-labels">
              <span class="g-legend"><span class="g-dot net"></span> 실수령액 (<span id="pct-net">86.4%</span>)</span>
              <span class="g-legend"><span class="g-dot insur"></span> 4대보험 (<span id="pct-insur">8.9%</span>)</span>
              <span class="g-legend"><span class="g-dot tax"></span> 세금 (<span id="pct-tax">4.7%</span>)</span>
            </div>
          </div>

          <!-- Action buttons -->
          <div class="res-action-row">
            <button type="button" id="btn-copy-result" class="btn-copy">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
              결과 요약 복사 (카톡 공유용)
            </button>
            <span id="copy-toast" class="copy-toast" style="display:none;">복사되었습니다!</span>
          </div>

          <!-- 결과 박스 내부 침투 인라인 배너 (공제액 실시간 연동) -->
          <div class="res-offset-banner">
            <div class="offset-text">
              💡 매달 떼이는 공제액 <strong id="banner-deduct-amt">475,820원</strong>, 퇴근 후 월 30만 원 부수입으로 메우는 법
            </div>
            <a href="/posts/01-side-income-platforms-guide/" class="offset-link">
              가이드 보기 →
            </a>
          </div>

          <!-- ═════════════════════════════════════════════════════════════
               [개선 3] 세부 공제 내역 접이식 아코디언 (기본 접힘)
               ═════════════════════════════════════════════════════════════ -->
          <div class="accordion-toggle-box" id="detail-accordion">
            <button type="button" class="accordion-btn" id="btn-accordion-toggle">
              <span>🔍 국민연금·건강보험 등 7개 공제 상세표 보기</span>
              <span class="accordion-arrow">▼</span>
            </button>
            <div class="accordion-content">
              <!-- Tab Toggle: Employee vs Employer -->
              <div class="tab-toggle-wrap">
                <button type="button" id="tab-btn-employee" class="tab-btn active">근로자 공제 상세</button>
                <button type="button" id="tab-btn-employer" class="tab-btn">회사(사업주) 부담금 보기</button>
              </div>

              <!-- Employee Breakdown Panel -->
              <div id="panel-employee" class="tab-panel">
                <table class="detail-table">
                  <thead>
                    <tr>
                      <th>공제 항목</th>
                      <th>2026년 요율</th>
                      <th class="text-right">공제 금액</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><strong>국민연금</strong></td>
                      <td>4.75% (개정)</td>
                      <td class="text-right"><strong id="amt-pension">156,750</strong>원</td>
                    </tr>
                    <tr>
                      <td><strong>건강보험</strong></td>
                      <td>3.595% (개정)</td>
                      <td class="text-right"><strong id="amt-health">118,630</strong>원</td>
                    </tr>
                    <tr>
                      <td><strong>노인장기요양</strong></td>
                      <td>건보료의 13.14%</td>
                      <td class="text-right"><strong id="amt-care">15,580</strong>원</td>
                    </tr>
                    <tr>
                      <td><strong>고용보험</strong></td>
                      <td>0.9% (실업급여)</td>
                      <td class="text-right"><strong id="amt-employ">29,700</strong>원</td>
                    </tr>
                    <tr class="subtotal">
                      <td colspan="2">4대보험 합계</td>
                      <td class="text-right"><span id="amt-insur-total">320,660</span>원</td>
                    </tr>
                    <tr>
                      <td><strong>근로소득세</strong></td>
                      <td>간이세액표 기준</td>
                      <td class="text-right"><strong id="amt-income-tax">141,050</strong>원</td>
                    </tr>
                    <tr>
                      <td><strong>지방소득세</strong></td>
                      <td>소득세의 10%</td>
                      <td class="text-right"><strong id="amt-local-tax">14,100</strong>원</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <!-- Employer Breakdown Panel -->
              <div id="panel-employer" class="tab-panel" style="display:none;">
                <div class="employer-info-box">
                  <div class="emp-total-stat">
                    <span>회사가 나를 위해 추가 부담하는 4대보험:</span>
                    <strong id="amt-emp-total">344,050원</strong>
                  </div>
                  <div class="emp-grand-total">
                    <span>내 월급에 들어가는 회사의 총 인건비:</span>
                    <strong id="amt-grand-cost">3,844,050원</strong>
                  </div>
                </div>
                <table class="detail-table">
                  <thead>
                    <tr>
                      <th>회사 부담 항목</th>
                      <th>사업주 요율</th>
                      <th class="text-right">회사 부담액</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>국민연금 (회사 부담)</td>
                      <td>4.75%</td>
                      <td class="text-right"><span id="amt-emp-pension">156,750</span>원</td>
                    </tr>
                    <tr>
                      <td>건강보험 (회사 부담)</td>
                      <td>3.595%</td>
                      <td class="text-right"><span id="amt-emp-health">118,630</span>원</td>
                    </tr>
                    <tr>
                      <td>노인장기요양 (회사 부담)</td>
                      <td>건보료의 13.14%</td>
                      <td class="text-right"><span id="amt-emp-care">15,580</span>원</td>
                    </tr>
                    <tr>
                      <td>고용보험 (실업+안정개발)</td>
                      <td>1.15%</td>
                      <td class="text-right"><span id="amt-emp-employ">37,950</span>원</td>
                    </tr>
                    <tr>
                      <td>산재보험 (회사 100%)</td>
                      <td>평균 1.47%</td>
                      <td class="text-right"><span id="amt-emp-accident">48,510</span>원</td>
                    </tr>
                  </tbody>
                </table>
              </div>

            </div>
          </div>
        </section>

        <!-- 데스크톱용 하단 머니 시크릿 리포트 (글 노출 전면화) -->
        <div class="desktop-knowledge-wrap knowledge-section-wrap">
          <div class="k-section-eyebrow">Dadanote Secret Report</div>
          <h2 class="k-section-title">💡 4대보험 떼이고 한숨 나올 때 꼭 읽어야 할 직장인 머니 시크릿 4선</h2>
          <div class="k-post-grid">
            <!-- Card 1 -->
            <div class="k-post-card">
              <div class="k-post-badge-row">
                <span class="k-category-pill platform">부수입 현실</span>
                <span class="k-fact-tag">공제액 역전 노하우</span>
              </div>
              <h3 class="k-post-hook">"2026년 4대보험 인상으로 깎인 월급, 퇴근 후 어떻게 메울까?"</h3>
