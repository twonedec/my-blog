---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "계산기 모음 — 다다노트";
const pageDesc = "다다노트에서 만든 실용 계산기 모음. 4대보험·실수령액 계산기, 아이 키·몸무게 성장 백분위 계산기 등.";

const tools = [
  {
    href: "/tools/4insur/",
    title: "4대보험 & 월급 실수령액 계산기",
    desc: "2026년 최신 요율로 4대보험 공제액과 실수령액을 1초 만에 계산합니다.",
    badge: "직장인",
  },
  {
    href: "/tools/growth/",
    title: "아이 키·몸무게 성장 백분위 계산기",
    desc: "질병관리청·대한소아청소년과학회 2017 공식 성장도표 기준으로 또래 대비 백분위를 계산합니다.",
    badge: "육아",
  },
];
---

<Layout title={pageTitle} description={pageDesc}>
  <div class="tools-page-wrap">
    <nav class="calc-breadcrumb">
      <a href="/">홈</a>
      <span class="sep">/</span>
      <span class="curr">계산기 모음</span>
    </nav>

    <header class="tools-header">
      <h1 class="tools-title">계산기 모음</h1>
      <p class="tools-subtitle">다다노트에서 직접 만든 실용 계산기입니다. 필요한 걸 골라 바로 써보세요.</p>
    </header>

    <div class="tools-grid">
      {tools.map((t) => (
        <a href={t.href} class="tool-card">
          <span class="tool-badge">{t.badge}</span>
          <h2 class="tool-card-title">{t.title}</h2>
          <p class="tool-card-desc">{t.desc}</p>
          <span class="tool-card-link">바로 계산하기 →</span>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
.tools-page-wrap { max-width: 900px; margin: 0 auto; padding: 40px 24px 100px; }

.calc-breadcrumb {
  display: flex; align-items: center; gap: 8px;
  font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
  color: var(--muted); margin-bottom: 24px;
}
.calc-breadcrumb a:hover { color: var(--ink); }
.calc-breadcrumb .sep { opacity: .4; }
.calc-breadcrumb .curr { color: var(--ink); font-weight: 600; }

.tools-header { margin-bottom: 36px; }
.tools-title {
  font-family: var(--serif); font-size: clamp(28px, 3.6vw, 40px); font-weight: 400;
  line-height: 1.25; letter-spacing: -.02em; color: var(--ink); margin-bottom: 12px;
}
.tools-subtitle { font-size: 15px; line-height: 1.7; color: var(--ink-2); }

.tools-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
@media (max-width: 640px) { .tools-grid { grid-template-columns: 1fr; } }

.tool-card {
  display: block; background: var(--bg-elev); border: 1px solid var(--line); border-radius: 12px;
  padding: 24px; text-decoration: none; box-shadow: 0 4px 20px oklch(0.15 0.01 85 / .03);
  transition: border-color .15s, transform .15s;
}
.tool-card:hover { border-color: var(--ink); transform: translateY(-2px); }

.tool-badge {
  display: inline-block; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 9999px;
  padding: 3px 10px; font-size: 11px; font-weight: 700; color: var(--ink-2); margin-bottom: 12px;
}
.tool-card-title { font-size: 17px; font-weight: 700; color: var(--ink); margin-bottom: 8px; line-height: 1.4; }
.tool-card-desc { font-size: 13.5px; line-height: 1.6; color: var(--muted); margin-bottom: 16px; }
.tool-card-link { font-size: 13px; font-weight: 700; color: var(--ink); }
</style>
