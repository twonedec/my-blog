// ═════════════════════════════════════════════════════════════
// 2026 근로소득 간이세액표 누진세율 및 4대보험 산정 로직
// ═════════════════════════════════════════════════════════════
function calculateIncomeTax(taxableMonthly: number): number {
  if (taxableMonthly <= 1060000) return 0;
  const annualIncome = taxableMonthly * 12;

  let earnedIncomeDeduction = 0;
  if (annualIncome <= 5000000) {
    earnedIncomeDeduction = annualIncome * 0.7;
  } else if (annualIncome <= 15000000) {
    earnedIncomeDeduction = 3500000 + (annualIncome - 5000000) * 0.4;
  } else if (annualIncome <= 45000000) {
    earnedIncomeDeduction = 7500000 + (annualIncome - 15000000) * 0.15;
  } else if (annualIncome <= 100000000) {
    earnedIncomeDeduction = 12000000 + (annualIncome - 45000000) * 0.05;
  } else {
    earnedIncomeDeduction = 14750000 + (annualIncome - 100000000) * 0.02;
  }

  const basicDeduction = 1500000;
  const pensionBase = Math.min(Math.max(taxableMonthly, 390000), 6170000);
  const annualPensionDeduction = pensionBase * 0.0475 * 12;
  const specialDeduction = Math.min(annualIncome * 0.08 + 2000000, 25000000);

  const taxBase = Math.max(0, annualIncome - earnedIncomeDeduction - basicDeduction - annualPensionDeduction - specialDeduction);

  let annualTax = 0;
  if (taxBase <= 14000000) {
    annualTax = taxBase * 0.06;
  } else if (taxBase <= 50000000) {
    annualTax = 840000 + (taxBase - 14000000) * 0.15;
  } else if (taxBase <= 88000000) {
    annualTax = 6240000 + (taxBase - 50000000) * 0.24;
  } else if (taxBase <= 150000000) {
    annualTax = 15360000 + (taxBase - 88000000) * 0.35;
  } else {
    annualTax = 37060000 + (taxBase - 150000000) * 0.38;
  }

  let earnedTaxCredit = 0;
  if (annualTax <= 1300000) {
    earnedTaxCredit = Math.min(annualTax * 0.55, 740000);
  } else {
    earnedTaxCredit = Math.min(715000 + (annualTax - 1300000) * 0.30, 660000);
  }

  const finalAnnualTax = Math.max(0, annualTax - earnedTaxCredit);
  return Math.floor((finalAnnualTax / 12) / 10) * 10;
}

function calculateDeductions(monthlyGross: number) {
  const taxable = Math.max(0, monthlyGross - 200000); // 식대 20만 비과세

  // 국민연금 4.75% (상한 6,170,000)
  const pensionBase = Math.min(Math.max(taxable, 390000), 6170000);
  const pension = Math.floor((pensionBase * 0.0475) / 10) * 10;

  // 건강보험 3.595%
  const healthBase = Math.min(Math.max(taxable, 279266), 119625120);
  const health = Math.floor((healthBase * 0.03595) / 10) * 10;

  // 장기요양 (건보료의 13.14%)
  const care = Math.floor((health * 0.1314) / 10) * 10;

  // 고용보험 (0.9%)
  const employ = Math.floor((taxable * 0.009) / 10) * 10;

  // 소득세 & 지방소득세
  const incomeTax = calculateIncomeTax(taxable);
  const localTax = Math.floor((incomeTax * 0.1) / 10) * 10;

  const totalDeductions = pension + health + care + employ + incomeTax + localTax;
  const net = monthlyGross - totalDeductions;

  return {
    net,
    totalDeductions,
    incomeTax,
    localTax,
    totalTax: incomeTax + localTax,
    totalInsur: pension + health + care + employ
  };
}

// ═════════════════════════════════════════════════════════════
// Core Calculation
// ═════════════════════════════════════════════════════════════
function calculate() {
  const monthlySalary = parseFormattedNumber(salaryInput.value);
  const monthlyHours = parseFloat(monthlyHoursInput.value) || 209;
  const dailyHours = parseFloat(dailyHoursInput.value) || 8;
  const unusedDays = parseFloat(unusedDaysInput.value) || 0;

  if (monthlyHours <= 0) return;

  // 1. 시간당 통상임금
  const hourlyWage = monthlySalary / monthlyHours;

  // 2. 1일 통상임금
  const dailyWage = hourlyWage * dailyHours;

  // 3. 미사용 연차수당 (세전)
  const totalAllowanceGross = dailyWage * unusedDays;

  // 4. 총 보상 근로 시간
  const totalCompHours = dailyHours * unusedDays;

  // 5. 당월 급여 합산 누진과세 시뮬레이션
  const basePayroll = calculateDeductions(monthlySalary);
  const combinedSalary = monthlySalary + totalAllowanceGross;
  const combinedPayroll = calculateDeductions(combinedSalary);

  // 연차수당으로 인해 실제로 더 공제되는 추가 세금 및 보험료 (한계 공제액)
  const marginalDeduction = combinedPayroll.totalDeductions - basePayroll.totalDeductions;
  
  // 실제 연차수당 순 실수령액 (통장에 실제로 더 찍히는 증가분)
  const realNetAllowance = combinedPayroll.net - basePayroll.net;
  const marginalRate = totalAllowanceGross > 0 ? (marginalDeduction / totalAllowanceGross) * 100 : 0;

  // Update Hero Result
  resAllowanceGross.textContent = formatNumber(totalAllowanceGross);
  resAllowanceNet.textContent = formatNumber(realNetAllowance);
  resMarginalDeduct.textContent = '-' + formatNumber(marginalDeduction) + '원';
  resMarginalRate.textContent = marginalRate.toFixed(1) + '%';
  resSummaryDays.textContent = unusedDays.toFixed(unusedDays % 1 === 0 ? 0 : 1);

  // Update Monthly Comparison Card
  compBaseGross.textContent = formatNumber(monthlySalary);
  compBaseNet.textContent = formatNumber(basePayroll.net);
  compBaseDeduct.textContent = formatNumber(basePayroll.totalDeductions);

  compTotalGross.textContent = formatNumber(combinedSalary);
  compTotalNet.textContent = formatNumber(combinedPayroll.net);
  compTotalDeduct.textContent = formatNumber(combinedPayroll.totalDeductions);
  compNetDiff.textContent = '+' + formatNumber(realNetAllowance) + '원';

  // Update 3 Metrics
  resDailyWage.textContent = formatNumber(dailyWage);
  resHourlyWage.textContent = formatNumber(hourlyWage);
  resMetricDays.textContent = unusedDays.toFixed(unusedDays % 1 === 0 ? 0 : 1);
  resTotalHours.textContent = totalCompHours.toFixed(totalCompHours % 1 === 0 ? 0 : 1);

  // Update Breakdown Math
  mathMonthlyWage.textContent = formatNumber(monthlySalary) + '원';
  mathMonthlyHours.textContent = monthlyHours + '시간';
  mathHourlyWage.textContent = formatNumber(hourlyWage) + '원';

  mathStep2Hourly.textContent = formatNumber(hourlyWage) + '원';
  mathDailyHours.textContent = dailyHours + '시간';
  mathDailyWage.textContent = formatNumber(dailyWage) + '원';

  mathStep3Daily.textContent = formatNumber(dailyWage) + '원';
  mathUnusedDays.textContent = unusedDays + '일';
  mathFinalAllowance.textContent = formatNumber(totalAllowanceGross) + '원';
}

// ═════════════════════════════════════════════════════════════
// Preset Selection & Hours Synchronization
// ═════════════════════════════════════════════════════════════
workPresetSelect.addEventListener('change', () => {
  const val = workPresetSelect.value;
  if (val === '40') {
    monthlyHoursInput.value = '209';
    monthlyHoursInput.readOnly = true;
    dailyHoursInput.value = '8';
    monthlyHoursDesc.textContent = '주 40h + 주휴 8h 기준 209h';
  } else if (val === '35') {
    monthlyHoursInput.value = '183';
    monthlyHoursInput.readOnly = true;
    dailyHoursInput.value = '7';
    monthlyHoursDesc.textContent = '주 35h + 주휴 7h 기준 183h';
  } else if (val === '30') {
    monthlyHoursInput.value = '157';
    monthlyHoursInput.readOnly = true;
    dailyHoursInput.value = '6';
    monthlyHoursDesc.textContent = '주 30h + 주휴 6h 기준 157h';
  } else if (val === '20') {
    monthlyHoursInput.value = '104';
    monthlyHoursInput.readOnly = true;
    dailyHoursInput.value = '4';
    monthlyHoursDesc.textContent = '주 20h + 주휴 4h 기준 104h';
  } else {
    // Custom
    monthlyHoursInput.readOnly = false;
    monthlyHoursInput.focus();
    monthlyHoursDesc.textContent = '월 기준 시간을 직접 입력하세요';
  }
  calculate();
});

// Event Listeners for Inputs
salaryInput.addEventListener('input', () => {
  const cursor = salaryInput.selectionStart;
  const oldLen = salaryInput.value.length;
  updateSalaryFormatting();
  const newLen = salaryInput.value.length;
  if (cursor !== null) {
    salaryInput.setSelectionRange(cursor + (newLen - oldLen), cursor + (newLen - oldLen));
  }
  calculate();
});

monthlyHoursInput.addEventListener('input', calculate);
dailyHoursInput.addEventListener('input', calculate);
unusedDaysInput.addEventListener('input', calculate);

// Stepper Buttons
btnMinus.addEventListener('click', () => {
  let val = parseFloat(unusedDaysInput.value) || 0;
  if (val > 0.5) {
    val = Math.max(0, val - 0.5);
    unusedDaysInput.value = val.toString();
    calculate();
  }
});

btnPlus.addEventListener('click', () => {
  let val = parseFloat(unusedDaysInput.value) || 0;
  val += 0.5;
  unusedDaysInput.value = val.toString();
  calculate();
});

// Quick Amount Buttons
document.querySelectorAll<HTMLButtonElement>('.btn-quick').forEach(btn => {
  btn.addEventListener('click', () => {
    const add = btn.getAttribute('data-add');
    const set = btn.getAttribute('data-set');
    let cur = parseFormattedNumber(salaryInput.value);

    if (add) {
      cur += parseInt(add, 10);
    } else if (set) {
      cur = parseInt(set, 10);
    }
    salaryInput.value = formatNumber(cur);
    calculate();
  });
});

// Reset Button
btnReset.addEventListener('click', () => {
  salaryInput.value = '3,500,000';
  workPresetSelect.value = '40';
  monthlyHoursInput.value = '209';
  monthlyHoursInput.readOnly = true;
  monthlyHoursDesc.textContent = '주 40h + 주휴 8h 기준 209h';
  dailyHoursInput.value = '8';
  unusedDaysInput.value = '5';
  calculate();
});

// ═════════════════════════════════════════════════════════════
// 입사일 기준 연차 발생일수 자동 계산기 (Helper)
// ═════════════════════════════════════════════════════════════
let computedRemainingLeave = 0;

// Set default dates
const today = new Date();
const yyyy = today.getFullYear();
const mm = String(today.getMonth() + 1).padStart(2, '0');
const dd = String(today.getDate()).padStart(2, '0');
const todayStr = `${yyyy}-${mm}-${dd}`;

// Default join date: 1 year ago today
const oneYearAgo = new Date();
oneYearAgo.setFullYear(today.getFullYear() - 1);
const jY = oneYearAgo.getFullYear();
const jM = String(oneYearAgo.getMonth() + 1).padStart(2, '0');
const jD = String(oneYearAgo.getDate()).padStart(2, '0');

joinDateInput.value = `${jY}-${jM}-${jD}`;
targetDateInput.value = todayStr;

btnToggleHelper.addEventListener('click', () => {
  const isHidden = helperPanel.style.display === 'none';
  helperPanel.style.display = isHidden ? 'block' : 'none';
  btnToggleHelper.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
  if (isHidden) {
    calculateHelperLeave();
  }
});

function calculateHelperLeave() {
  if (!joinDateInput.value || !targetDateInput.value) return;

  const joinDate = new Date(joinDateInput.value);
  const targetDate = new Date(targetDateInput.value);

  if (targetDate < joinDate) {
    hTenureStr.textContent = '기준일이 입사일보다 빠릅니다';
    hTotalLeave.textContent = '0 일';
    hRemainingLeave.textContent = '0 일';
    return;
  }

  // Calculate tenure in full years and remaining months
  let years = targetDate.getFullYear() - joinDate.getFullYear();
  let months = targetDate.getMonth() - joinDate.getMonth();
  let days = targetDate.getDate() - joinDate.getDate();

  if (days < 0) {
    months -= 1;
  }
  if (months < 0) {
    years -= 1;
    months += 12;
  }

  const tenureStr = years > 0 ? `${years}년 ${months}개월` : `${months}개월`;
  hTenureStr.textContent = tenureStr;

  // Calculate annual leave according to Article 60 of the Labor Standards Act
  let totalGranted = 0;

  if (years < 1) {
    // 1년 미만: 1개월 개근 시 1일씩 (최대 11일)
    // 총 근무 개월 수 (months)
    totalGranted = Math.min(11, Math.max(0, months));
  } else {
    // 1년 이상: 기본 15일 + 3년 이상 근무 시 매 2년마다 1일 가산 (최대 25일)
    // 당해 연도 발생 기준:
    const additionalDays = Math.floor((years - 1) / 2);
    totalGranted = Math.min(25, 15 + additionalDays);
  }

  const used = parseFloat(usedDaysInput.value) || 0;
  computedRemainingLeave = Math.max(0, totalGranted - used);

  hTotalLeave.textContent = `${totalGranted} 일`;
  hRemainingLeave.textContent = `${computedRemainingLeave} 일`;
  btnApplyLeave.textContent = `👉 잔여 연차 ${computedRemainingLeave}일을 계산기에 바로 적용하기`;
}

joinDateInput.addEventListener('change', calculateHelperLeave);
targetDateInput.addEventListener('change', calculateHelperLeave);
usedDaysInput.addEventListener('input', calculateHelperLeave);

// Apply Helper Result to Main Input
btnApplyLeave.addEventListener('click', () => {
  unusedDaysInput.value = computedRemainingLeave.toString();
  calculate();
  // Smooth scroll to result section
  const resSec = document.getElementById('result-section');
  if (resSec) {
    resSec.scrollIntoView({ behavior: 'smooth' });
  }
});

// ═════════════════════════════════════════════════════════════
// Copy Result Summary
// ═════════════════════════════════════════════════════════════
btnCopyResult.addEventListener('click', async () => {
  const gross = resAllowanceGross.textContent || '0';
  const net = resAllowanceNet.textContent || '0';
  const marginalDeduct = resMarginalDeduct.textContent || '0';
  const marginalRate = resMarginalRate.textContent || '0%';
  const days = resSummaryDays.textContent || '0';
  const daily = resDailyWage.textContent || '0';
  const hourly = resHourlyWage.textContent || '0';
  const salary = salaryInput.value;
  const baseNet = compBaseNet.textContent || '0';
  const totalNet = compTotalNet.textContent || '0';

  const copyText = `[다다노트 2026 연차수당 계산 결과]
• 월 기본 통상임금: ${salary}원
• 1일 통상임금(8h): ${daily}원 (시급 ${hourly}원)
• 미사용 연차: ${days}일
------------------------------
▶ 세전 연차수당 총액: ${gross}원
▶ 당월 합산 추가 공제액: ${marginalDeduct} (실질 공제율 ${marginalRate})
▶ 실제 연차수당 순 실수령액: ${net}원
(※ 당월 기본급에 합산되어 소득세 누진세율 및 4대보험 원천징수 반영)
------------------------------
▶ 평소 월급 실수령액: ${baseNet}원
▶ 연차수당 합산 월 총 실수령액: ${totalNet}원 (순 증가분 +${net}원)
------------------------------
계산기 바로가기: https://dadanote.net/tools/annual-leave/`;

  try {
    await navigator.clipboard.writeText(copyText);
    copyToast.style.display = 'inline';
    setTimeout(() => {
      copyToast.style.display = 'none';
    }, 3000);
  } catch (err) {
    alert('결과 복사에 실패했습니다.');
  }
});

// Initial Run
calculate();
</script>
