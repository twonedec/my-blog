---
import Layout from '../../layouts/Layout.astro';
import Adsense from '../../components/Adsense.astro';

const pageTitle = "2026 연차수당 & 미사용 연차 계산기 — 다다노트";
const pageDesc = "2026년 최신 근로기준법 기준 통상임금 기반 1일 통상임금, 시간당 통상임금, 미사용 연차수당(세전·세후)을 1초 만에 자동 계산합니다. 입사일 기준 연차 발생일수 계산기 및 근로기준법 가이드 수록.";
---

<Layout title={pageTitle} description={pageDesc} ogImage="/og/annual-leave.png">
  <div class="calc-page-wrap">
    <!-- Breadcrumb -->
    <nav class="calc-breadcrumb">
      <a href="/">홈</a>
      <span class="sep">/</span>
      <a href="/tools/">계산기</a>
      <span class="sep">/</span>
      <span class="curr">2026 연차수당 & 미사용 연차 계산기</span>
    </nav>

    <!-- Header -->
    <header class="calc-header">
      <div class="calc-badge">
        <span class="dot"></span> 2026 근로기준법 기준 · 통상임금 100% 산정 공식 적용
      </div>
      <h1 class="calc-title">연차수당 & 미사용 연차 계산기</h1>
      <p class="calc-subtitle">
        월 통상임금과 근무시간, 남은 연차 일수만 넣으면 <strong>1일 통상임금</strong>과 
        <strong>미사용 연차 보상 수당(세전·세후)</strong>을 즉시 산출해 드립니다. 
        내 남은 연차가 몇 개인지 헷갈린다면 <strong>입사일 기준 연차 발생일수 계산기</strong>를 함께 활용하세요.
      </p>
    </header>

    <Adsense />

    <!-- ═════════════════════════════════════════════════════════════
         메인 입력 패널
         ═════════════════════════════════════════════════════════════ -->
    <section class="calc-card input-panel-card">
      <div class="panel-header-row">
        <h2 class="panel-section-title">
          <span class="icon">💼</span> 급여 및 근로 조건 입력
        </h2>
        <button type="button" id="btn-reset" class="calc-reset-btn">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
          초기화
        </button>
      </div>

      <div class="input-grid">
        <!-- 1. 통상임금 입력 -->
        <div class="form-item span-2">
          <label for="monthly-salary">
            <span>월 통상임금 (기본급 + 고정수당) <span class="req">*</span></span>
            <span class="sub-hint">정기상여금·식대 등 고정 지급액 합산</span>
          </label>
          <div class="input-unit-box">
            <input 
              type="text" 
              id="monthly-salary" 
              class="h-input" 
              value="3,500,000" 
              inputmode="numeric" 
              placeholder="예: 3,500,000" 
            />
            <span class="unit">원</span>
          </div>
          <!-- 빠른 금액 증감 버튼 -->
          <div class="quick-btn-group">
            <button type="button" class="btn-quick" data-add="100000">+10만</button>
            <button type="button" class="btn-quick" data-add="500000">+50만</button>
            <button type="button" class="btn-quick" data-add="1000000">+100만</button>
            <button type="button" class="btn-quick reset" data-set="3500000">기본값(350만)</button>
          </div>
        </div>

        <!-- 2. 주 소정근로시간 -->
        <div class="form-item">
          <label for="work-hours-preset">
            <span>주 소정근로시간 <span class="req">*</span></span>
            <span class="sub-hint">일반 직장인은 주 40시간(209시간)</span>
          </label>
          <select id="work-hours-preset" class="h-select">
            <option value="40" selected>주 40시간 (월 209시간 · 기본)</option>
            <option value="35">주 35시간 (월 183시간)</option>
            <option value="30">주 30시간 (월 157시간)</option>
            <option value="20">주 20시간 (월 104시간 · 단시간)</option>
            <option value="custom">직접 입력</option>
          </select>
        </div>

        <!-- 3. 월 소정근로시간 (선택/직접입력) -->
        <div class="form-item" id="monthly-hours-wrap">
          <label for="monthly-hours">
            <span>월 기준시간 (주휴 포함)</span>
            <span class="sub-hint" id="monthly-hours-desc">주 40h + 주휴 8h 기준 209h</span>
          </label>
          <div class="input-unit-box">
            <input 
              type="number" 
              id="monthly-hours" 
              class="h-input" 
              value="209" 
              step="1"
              readonly
            />
            <span class="unit">시간</span>
          </div>
        </div>

        <!-- 4. 1일 소정근로시간 -->
        <div class="form-item">
          <label for="daily-hours">
            <span>1일 소정근로시간</span>
            <span class="sub-hint">통상 8시간 (주 40시간 ÷ 5일)</span>
          </label>
          <div class="input-unit-box">
            <input 
              type="number" 
              id="daily-hours" 
              class="h-input" 
              value="8" 
              min="1" 
              max="24" 
              step="0.5"
            />
            <span class="unit">시간</span>
          </div>
        </div>

        <!-- 5. 미사용 연차 일수 -->
        <div class="form-item">
          <label for="unused-days">
            <span>미사용 연차 일수 <span class="req">*</span></span>
            <span class="sub-hint">0.5일(반차) 단위 입력 가능</span>
          </label>
          <div class="stepper-input-box">
            <button type="button" class="btn-step" id="btn-step-minus" aria-label="1일 감소">-</button>
            <input 
              type="number" 
              id="unused-days" 
              class="h-input text-center" 
              value="5" 
              min="0.5" 
              max="100" 
              step="0.5"
            />
            <button type="button" class="btn-step" id="btn-step-plus" aria-label="1일 증가">+</button>
            <span class="unit">일</span>
          </div>
        </div>
      </div>

      <!-- 입사일 기준 연차 발생일수 도우미 트리거 버튼 -->
      <div class="helper-toggle-area">
        <button type="button" id="btn-toggle-helper" class="btn-helper-toggle" aria-expanded="false">
          <span class="helper-icon">📅</span>
          <span class="helper-text">
            <strong>내 남은 연차가 몇 개인지 모르겠다면?</strong>
            <span class="sub">입사일 기준 연차 발생 일수 자동 계산 도우미 열기</span>
          </span>
          <span class="toggle-arrow">▼</span>
        </button>
      </div>

      <!-- 입사일 기준 연차 발생일수 도우미 본체 (접이식) -->
      <div id="leave-calc-helper" class="helper-panel-box" style="display: none;">
        <div class="helper-inner">
          <div class="helper-header">
            <span class="helper-badge">근로기준법 제60조 기준</span>
            <h3 class="helper-title">입사일 기준 연차 발생 일수 자동 계산기</h3>
            <p class="helper-sub">
              입사일과 기준일(오늘 또는 퇴직일)을 선택하시면 법정 연차 발생 일수를 바로 계산해 드립니다.
            </p>
          </div>

          <div class="helper-input-grid">
            <div class="form-item">
              <label for="join-date">입사일자</label>
              <input type="date" id="join-date" class="h-input" />
            </div>

            <div class="form-item">
              <label for="target-date">기준일자 (오늘 또는 퇴직일)</label>
              <input type="date" id="target-date" class="h-input" />
            </div>

            <div class="form-item">
              <label for="used-days-input">사용한 연차 일수</label>
              <div class="input-unit-box">
                <input type="number" id="used-days-input" class="h-input" value="0" min="0" step="0.5" />
                <span class="unit">일</span>
              </div>
            </div>
          </div>

          <!-- 도우미 연산 결과 -->
          <div id="helper-result-box" class="helper-result-box">
            <div class="helper-res-row">
              <span class="h-res-label">근속 기간</span>
              <strong id="h-tenure-str" class="h-res-val">-</strong>
            </div>
            <div class="helper-res-row">
              <span class="h-res-label">근로기준법상 발생 총 연차</span>
              <strong id="h-total-leave" class="h-res-val">- 일</strong>
            </div>
            <div class="helper-res-row highlight">
              <span class="h-res-label">남은 미사용 연차</span>
              <strong id="h-remaining-leave" class="h-res-val text-primary">- 일</strong>
            </div>
          </div>

          <div class="helper-action-row">
            <button type="button" id="btn-apply-leave" class="btn-apply-leave">
              👉 계산된 잔여 연차 일수를 계산기에 바로 적용하기
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ═════════════════════════════════════════════════════════════
         결과 대시보드
         ═════════════════════════════════════════════════════════════ -->
    <section class="calc-card result-dashboard-card" id="result-section">
      <!-- 히어로 요약 카드 -->
      <div class="res-hero-box">
        <div class="hero-top-tag">
          <span class="tag-pulse"></span> 예상 연차수당 지급액
        </div>
        <div class="res-hero-amount">
          <span id="res-allowance-gross" class="hero-number">669,855</span>
          <span class="hero-unit">원</span>
        </div>
        <p class="hero-caption">
          미사용 연차 <strong id="res-summary-days">5</strong>일에 대해 회사로부터 지급받을 <strong>세전 총액</strong>입니다.
        </p>

        <!-- 세후 실수령액 추정 알림 (당월 급여 합산 누진세율 반영) -->
        <div class="net-estimate-badge-box">
          <div class="net-box-left">
            <span class="net-title">실제 연차수당 순 실수령액 (세후)</span>
            <span class="net-value"><strong id="res-allowance-net">531,820</strong> 원</span>
          </div>
          <div class="net-deduct-pill">
            당월 합산 추가 공제: <strong id="res-marginal-deduct">-138,035원</strong> (실질 공제율 <span id="res-marginal-rate">20.6%</span>)
          </div>
          <div class="net-box-desc">
            * <strong>당월 급여 합산 누진과세 반영:</strong> 연차수당은 독립 지급이 아니라 해당 월 기본급에 전액 합산되므로, 소득세 과세표준 구간이 한 단계 상승하여 평소보다 높은 누진세율과 4대보험이 적용됩니다.
          </div>
        </div>
      </div>

      <!-- 당월 급여 합산 실수령액 비교 시뮬레이션 카드 -->
      <div class="monthly-comparison-box">
        <h3 class="comparison-title">
          <span>📊</span> 연차수당 지급 월 통장 실수령액 비교 (누진세율 적용)
        </h3>
        <div class="comparison-grid">
          <div class="comp-col">
            <span class="comp-tag">평소 월급 수령 시</span>
            <div class="comp-gross">세전 <span id="comp-base-gross">3,500,000</span>원</div>
            <div class="comp-net">통장 입금: <strong><span id="comp-base-net">3,024,180</span>원</strong></div>
            <div class="comp-deduct">공제 총액: <span id="comp-base-deduct">475,820</span>원</div>
          </div>
          <div class="comp-divider">
            <span class="plus-icon">+ 연차수당</span>
            <span class="arrow-icon">➔</span>
          </div>
          <div class="comp-col highlight">
            <span class="comp-tag special">연차수당 합산 월</span>
            <div class="comp-gross">총 지급: <span id="comp-total-gross">4,169,855</span>원</div>
            <div class="comp-net">최종 입금: <strong><span id="comp-total-net">3,556,000</span>원</strong></div>
            <div class="comp-deduct">총 공제: <span id="comp-total-deduct">613,855</span>원</div>
          </div>
        </div>
        <div class="comp-footer">
          👉 연차수당 지급으로 이번 달 내 통장에 실제로 <strong>더 입금되는 순 증가액</strong>: <span class="text-success"><strong id="comp-net-diff">+531,820원</strong></span>
        </div>
      </div>

      <!-- 3대 핵심 지표 카드 -->
      <div class="key-metrics-grid">
        <div class="metric-card">
          <span class="m-card-label">1일 통상임금</span>
          <div class="m-card-val"><span id="res-daily-wage">133,971</span> <span class="unit">원</span></div>
          <span class="m-card-sub">시간급 × 1일 소정근로시간(8h)</span>
        </div>

        <div class="metric-card">
          <span class="m-card-label">시간당 통상임금</span>
          <div class="m-card-val"><span id="res-hourly-wage">16,746</span> <span class="unit">원</span></div>
          <span class="m-card-sub">월 통상임금 ÷ 월 소정시간(209h)</span>
        </div>

        <div class="metric-card">
          <span class="m-card-label">적용 미사용 일수</span>
          <div class="m-card-val"><span id="res-metric-days">5.0</span> <span class="unit">일</span></div>
          <span class="m-card-sub">총 보상 시간: <strong id="res-total-hours">40</strong>시간</span>
        </div>
      </div>

      <!-- 상세 계산 공식 단계별 분해 (수식 투명화) -->
      <div class="breakdown-accordion-wrap">
        <h3 class="breakdown-title">
          <span>📐</span> 연차수당 산출 공식 단계별 상세 보기
        </h3>
        
        <div class="formula-steps">
          <div class="formula-step-card">
            <div class="step-num">1단계</div>
            <div class="step-body">
              <span class="step-label">시간당 통상임금 산출</span>
              <div class="step-math">
                <span id="math-monthly-wage">3,500,000원</span> ÷ <span id="math-monthly-hours">209시간</span> = <strong><span id="math-hourly-wage">16,746원</span> / 시간</strong>
              </div>
            </div>
          </div>

          <div class="formula-step-card">
            <div class="step-num">2단계</div>
            <div class="step-body">
              <span class="step-label">1일 통상임금 (8시간 기준)</span>
              <div class="step-math">
                <span id="math-step2-hourly">16,746원</span> × <span id="math-daily-hours">8시간</span> = <strong><span id="math-daily-wage">133,971원</span> / 일</strong>
              </div>
            </div>
          </div>

          <div class="formula-step-card highlight">
            <div class="step-num">3단계</div>
            <div class="step-body">
              <span class="step-label">최종 미사용 연차수당 산정</span>
              <div class="step-math">
                <span id="math-step3-daily">133,971원</span> × <span id="math-unused-days">5일</span> = <strong class="text-primary"><span id="math-final-allowance">669,855원</span></strong>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 공유 및 복사 액션 바 -->
      <div class="result-action-bar">
        <button type="button" id="btn-copy-result" class="btn-copy-result">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          계산 결과 요약 복사하기
        </button>
        <span id="copy-toast" class="copy-toast" style="display:none;">복사되었습니다! 필요한 곳에 붙여넣으세요.</span>
      </div>

      <!-- 관련 도구 링크 배너 -->
      <div class="related-tool-banner">
        <div class="banner-text">
          💡 연차수당 수령 후 이달 <strong>내 전체 월급 실수령액</strong>이 궁금하다면?
        </div>
        <a href="/tools/4insur/" class="banner-link">
          2026 4대보험 & 실수령액 계산기 바로가기 →
        </a>
      </div>
    </section>

    <Adsense />

    <!-- ═════════════════════════════════════════════════════════════
         SEO & AdSense 심층 지식 가이드: 근로기준법 핵심 4선
         ═════════════════════════════════════════════════════════════ -->
    <article class="guide-article-wrap">
      <header class="guide-header">
        <span class="guide-badge">근로기준법 실무 총정리</span>
        <h2 class="guide-main-title">직장인이 꼭 알아야 할 연차수당 법적 권리와 핵심 4원칙</h2>
        <p class="guide-main-desc">
          "회사가 연차를 돈으로 안 준다는데 합법인가요?", "퇴사할 때 남은 연차는 어떻게 정산받나요?"<br/>
          근로기준법 제60조·제61조와 대법원 최신 판례를 바탕으로 직장인이 반드시 챙겨야 할 핵심 권리를 정리했습니다.
        </p>
      </header>

      <!-- 가이드 카드 1: 통상임금 포함 항목 vs 제외 항목 -->
      <div class="guide-content-card">
        <h3 class="guide-card-title">1. 통상임금이란? 포함되는 수당 vs 제외되는 수당</h3>
        <p class="guide-card-desc">
          연차수당 계산의 핵심은 <strong>‘통상임금(Regular Wage)’</strong>입니다. 통상임금이란 근로자에게 정기적이고 일률적이며 고정적으로 지급하기로 정한 시급·일급·월급을 말합니다.
        </p>

        <div class="table-responsive">
          <table class="guide-table">
            <thead>
              <tr>
                <th style="width: 25%;">구분</th>
                <th style="width: 45%;">해당 항목</th>
                <th style="width: 30%;">통상임금 인정 여부</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>기본급</strong></td>
                <td>근로계약서상 명시된 월 기본급</td>
                <td><span class="tag-ok">100% 포함</span></td>
              </tr>
              <tr>
                <td><strong>직책·직급수당</strong></td>
                <td>팀장, 파트장 등 직책 수행에 따라 고정 지급</td>
                <td><span class="tag-ok">100% 포함</span></td>
              </tr>
              <tr>
                <td><strong>고정 식대</strong></td>
                <td>실제 식사 여부와 무관하게 매월 고정 지급 (예: 20만 원)</td>
                <td><span class="tag-ok">원칙적 포함</span></td>
              </tr>
              <tr>
                <td><strong>정기상여금</strong></td>
                <td>지급 기준이 사전에 확정되어 정기적·일률적으로 지급되는 상여</td>
                <td><span class="tag-ok">포함 (대법원 판례)</span></td>
              </tr>
              <tr>
                <td><strong>연장·야간·휴일수당</strong></td>
                <td>실제 초과 근무 실적에 따라 변동 지급되는 수당</td>
                <td><span class="tag-no">제외</span></td>
              </tr>
              <tr>
                <td><strong>실비변상 교통비</strong></td>
                <td>출장비, 영수증 실비 정산 교통비</td>
                <td><span class="tag-no">제외</span></td>
              </tr>
              <tr>
                <td><strong>경영성과급</strong></td>
                <td>회사 경영 실적에 따라 임의적으로 지급되는 일회성 인센티브</td>
                <td><span class="tag-no">제외</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="guide-tip-text">
          📌 <strong>팁:</strong> 본인의 급여명세서에서 고정적으로 매달 똑같이 지급되는 항목들의 합계가 바로 통상임금 산정 기준이 됩니다.
        </p>
      </div>

      <!-- 가이드 카드 2: 근무 기간별 연차 발생 일수 규정 -->
      <div class="guide-content-card">
        <h3 class="guide-card-title">2. 근무 연수별 법정 연차 발생 일수 기준</h3>
        <p class="guide-card-desc">
          근로기준법 제60조에 따라 연차유급휴가는 입사 첫해와 1년 이상 근무자의 발생 메커니즘이 다릅니다.
        </p>

        <div class="timeline-steps">
          <div class="timeline-item">
            <span class="time-pill">1년 미만 신입사원</span>
            <div class="time-body">
              <strong>1개월 개근 시마다 1일씩 발생 (최대 11일)</strong>
              <p>입사 첫해 11개월 동안 매월 개근하면 총 11일의 연차가 발생합니다. 단, 발생한 연차는 입사일로부터 1년 이내에 사용해야 합니다.</p>
            </div>
          </div>

          <div class="timeline-item">
            <span class="time-pill">만 1년 근무 완료</span>
            <div class="time-body">
              <strong>기본 15일 일괄 부여 (출근율 80% 이상 시)</strong>
              <p>입사 만 1년이 되는 날 15일의 연차가 새로 부여됩니다. 신입 첫해에 부여받은 11일과 완전히 별개의 독립된 연차입니다.</p>
            </div>
          </div>

          <div class="timeline-item">
            <span class="time-pill">3년 이상 근속자</span>
            <div class="time-body">
              <strong>매 2년마다 1일씩 가산 (최대 25일 한도)</strong>
              <p>근속 3년 차부터는 2년마다 1일이 추가되어 16일, 5년 차 17일, 7년 차 18일 순으로 늘어나며 법적 상한선은 25일입니다.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- 가이드 카드 3: 연차 사용촉진제도와 수당 미지급 요건 -->
      <div class="guide-content-card">
        <h3 class="guide-card-title">3. 회사가 연차수당을 안 줘도 되는 유일한 경우: ‘연차 촉진제도’</h3>
        <p class="guide-card-desc">
          원칙적으로 미사용 연차는 돈(수당)으로 보상해야 합니다. 하지만 회사가 근로기준법 제61조에 따른 <strong>‘연차유급휴가 사용촉진조치’</strong>를 법적 절차대로 엄격하게 이행했다면, 근로자가 쓰지 않은 연차에 대해 수당 지급 의무가 면제됩니다.
        </p>

        <div class="alert-box-warning">
          <strong>⚠️ 적법한 사용촉진 요건 (2단계 필수 충족):</strong>
          <ol>
            <li><strong>1차 서면 촉구:</strong> 연차 소멸 6개월 전(1년 미만자는 3개월 전)을 기준으로 근로자별 잔여 일수를 서면으로 통보하고 사용 시기 지정을 요구해야 합니다.</li>
            <li><strong>2차 사용 시기 강제 지정:</strong> 근로자가 1차 통보를 받고도 10일 이내에 시기를 정하지 않으면, 회사가 소멸 2개월 전(1년 미만자는 1개월 전)까지 휴가 일자를 직접 지정하여 서면으로 통보해야 합니다.</li>
          </ol>
          <span class="sub-alert">* 구두 안내, 사내 단톡방 공지, 전체 메일 발송은 법적 효력이 인정되지 않으며, 회사는 연차수당을 전액 지급해야 합니다.</span>
        </div>
      </div>

      <!-- 가이드 카드 4: 퇴사 시 연차 정산 원칙 & 3년 소멸시효 -->
      <div class="guide-content-card">
        <h3 class="guide-card-title">4. 퇴사 시 미사용 연차 정산 원칙 & 소멸시효 3년</h3>
        <p class="guide-card-desc">
          퇴직할 때 남은 연차는 회사의 연차 촉진제도 시행 여부와 상관없이 <strong>100% 현금으로 정산받을 권리</strong>가 있습니다.
        </p>
        <ul class="guide-bullet-list">
          <li><strong>퇴직으로 인한 연차수당:</strong> 퇴직 당일까지 소진하지 못한 잔여 연차는 퇴직일로부터 14일 이내에 전액 현금 지급되어야 합니다.</li>
          <li><strong>퇴직금 산정 반영:</strong> 퇴직 전년도에 이미 발생했으나 쓰지 못해 발생한 연차수당은 3/12을 평균임금에 산입하여 퇴직금을 더 높여줍니다. (단, 퇴직으로 인해 비로소 발생한 연차수당은 제외)</li>
          <li><strong>임금채권 소멸시효 3년:</strong> 연차수당 청구권은 발생일로부터 <strong>3년간</strong> 유효합니다. 과거 3년 동안 미지급된 연차수당이 있다면 고용노동부를 통해 소급 청구할 수 있습니다.</li>
        </ul>
      </div>

      <!-- FAQ 아코디언 -->
      <div class="guide-content-card">
        <h3 class="guide-card-title">자주 묻는 질문 (FAQ)</h3>

        <div class="faq-list">
          <details class="calc-guide-accordion" open>
            <summary class="guide-summary">
              <span class="summary-left">
                <span class="guide-icon">❓</span>
                <span class="summary-title">연차수당을 받으면 왜 평소보다 세금을 훨씬 더 많이 떼이나요?</span>
              </span>
              <span class="accordion-arrow">▼</span>
            </summary>
            <div class="guide-accordion-body">
              <p>
                <strong>당월 기본 급여에 합산되어 ‘누진세율’이 적용되기 때문입니다.</strong><br/>
                연차수당은 비과세나 별도 분리과세가 아닌, <strong>지급받는 달의 일반 근로소득</strong>으로 전액 합산됩니다. 대한민국 소득세는 소득이 커질수록 높은 세율(6% ➔ 15% ➔ 24% 등)을 매기는 누진세율 구조를 취하고 있습니다.<br/>
                따라서 연차수당이 얹어지면 해당 월 과세표준 구간이 한 단계 뛰어오르며 <strong>더 높은 한계세율(Marginal Tax Rate)</strong>이 적용되어 평소보다 소득세가 껑충 뛰게 됩니다. 여기에 건강보험(3.595%)과 고용보험(0.9%)도 추가 공제되므로, 실질 공제율은 통상 15%~22% 수준에 달합니다. 본 계산기는 이 합산 누진효과를 실시간으로 정밀 시뮬레이션해 드립니다.
              </p>
            </div>
          </details>

          <details class="calc-guide-accordion">
            <summary class="guide-summary">
              <span class="summary-left">
                <span class="guide-icon">❓</span>
                <span class="summary-title">반차(0.5일)나 반반차(0.25일)도 연차수당으로 받을 수 있나요?</span>
              </span>
              <span class="accordion-arrow">▼</span>
            </summary>
            <div class="guide-accordion-body">
              <p>
                <strong>네, 당연히 비례 정산됩니다.</strong> 0.5일(4시간) 미사용 연차는 1일 통상임금의 50%(시간급 × 4시간)로 계산되어 정확하게 수당으로 지급받으실 수 있습니다. 본 계산기에 0.5단위로 입력해 확인해 보세요.
              </p>
            </div>
          </details>

          <details class="calc-guide-accordion">
            <summary class="guide-summary">
              <span class="summary-left">
                <span class="guide-icon">❓</span>
                <span class="summary-title">5인 미만 소규모 사업장에서도 연차수당이 보장되나요?</span>
              </span>
              <span class="accordion-arrow">▼</span>
            </summary>
            <div class="guide-accordion-body">
              <p>
                <strong>안타깝게도 법적 의무가 아닙니다.</strong> 현행 근로기준법상 연차유급휴가 규정(제60조)은 상시 근로자 수 5인 이상 사업장에만 적용됩니다. 따라서 5인 미만 사업장은 회사 취업규칙이나 근로계약서에 별도 약정이 없는 한 법적으로 연차휴가 및 연차수당이 강제되지 않습니다.
              </p>
            </div>
          </details>

          <details class="calc-guide-accordion">
            <summary class="guide-summary">
              <span class="summary-left">
                <span class="guide-icon">❓</span>
                <span class="summary-title">회계연도 기준(1월 1일)과 입사일 기준 중 무엇이 적용되나요?</span>
              </span>
              <span class="accordion-arrow">▼</span>
            </summary>
            <div class="guide-accordion-body">
              <p>
                근로기준법의 대원칙은 <strong>‘입사일 기준’</strong>입니다. 다만 많은 기업이 인사 관리 편의상 매년 1월 1일 일괄 부여하는 ‘회계연도 기준’을 활용합니다. 중요한 점은 <strong>퇴직 시점에 입사일 기준과 비교하여 근로자에게 더 유리한(일수가 많은) 쪽으로 정산</strong>해야 법 위반이 되지 않습니다.
              </p>
            </div>
          </details>
        </div>
      </div>
    </article>
  </div>
</Layout>

