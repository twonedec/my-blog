---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts    = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pick = posts[0];          // 최신 대표 글 1편
const recentList = posts.slice(1, 4); // 최근 글 3편

const readMin = (body: string) => Math.max(1, Math.ceil(body.replace(/\s+/g, '').length / 700));
const fmtDate = (d: Date)      => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout title="다다노트 — 직장인 현실 부수입 실전 가이드">
<style>
/* ── Minimal Hub Layout ──────────────────────────────── */
.hub-wrap {
  max-width: 980px;
  margin: 0 auto;
  padding: 64px 32px 96px;
}

/* 1. Header */
.hub-header {
  padding-bottom: 40px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 44px;
}
.hub-meta {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: .15em;
  color: var(--muted);
  text-transform: uppercase;
  margin-bottom: 16px;
}
.hub-header h1 {
  font-family: var(--serif);
  font-size: clamp(36px, 4vw, 52px);
  font-weight: 300;
  line-height: 1.15;
  letter-spacing: -.02em;
  color: var(--ink);
  margin-bottom: 14px;
}
.hub-header h1 em {
  font-style: italic;
  color: var(--ink-2);
}
.hub-header p {
  font-family: var(--serif);
  font-size: 17px;
  line-height: 1.6;
  color: var(--ink-2);
  font-weight: 300;
}

/* 2. Featured Focus (최신 대표 글 1편) */
.hub-featured {
  background: var(--bg-elev);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 36px 40px;
  margin-bottom: 44px;
  transition: border-color .2s;
}
.hub-featured:hover {
  border-color: var(--line-s);
}
.featured-label {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .15em;
  color: var(--c-income);
  text-transform: uppercase;
  margin-bottom: 12px;
}
.hub-featured h2 {
  font-family: var(--serif);
  font-size: 24px;
  font-weight: 400;
  line-height: 1.35;
  letter-spacing: -.015em;
  color: var(--ink);
  margin-bottom: 12px;
}
.hub-featured p {
  font-size: 14.5px;
  color: var(--ink-2);
  line-height: 1.65;
  margin-bottom: 20px;
}
.featured-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12.5px;
  color: var(--muted);
}
.featured-link {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--ink);
  border-bottom: 1px solid var(--ink);
  padding-bottom: 2px;
}

/* 3. Utility Tools Strip (실전 도구) */
.tools-strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 48px;
}
.tool-box {
  padding: 20px 24px;
  background: var(--bg-soft);
  border: 1px solid var(--line);
  border-radius: 6px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all .2s;
}
.tool-box:hover {
  background: var(--bg-elev);
  border-color: var(--line-s);
}
.tool-box h4 {
  font-family: var(--serif);
  font-size: 16px;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 4px;
}
.tool-box p {
  font-size: 12.5px;
  color: var(--muted);
}
.tool-arrow {
  font-size: 16px;
  color: var(--muted);
  transition: transform .2s, color .2s;
}
.tool-box:hover .tool-arrow {
  transform: translateX(4px);
  color: var(--ink);
}

/* 4. Recent Updates (최근 글 3편만 미니멀하게) */
.recent-section {
  padding-top: 12px;
}
.section-title-bar {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 4px;
}
.section-title-bar h3 {
  font-family: var(--serif);
  font-size: 18px;
  font-weight: 500;
  color: var(--ink);
}
.section-title-bar a {
  font-size: 12.5px;
  color: var(--muted);
  border-bottom: 1px solid var(--line-s);
  padding-bottom: 2px;
}
.section-title-bar a:hover {
  color: var(--ink);
}

.recent-row {
  display: grid;
  grid-template-columns: 100px 1fr auto;
  align-items: baseline;
  gap: 20px;
  padding: 16px 8px;
  border-bottom: 1px solid var(--line);
  transition: background-color .15s;
  border-radius: 4px;
}
.recent-row:hover {
  background-color: var(--bg-soft);
}
.recent-date {
  font-family: var(--mono);
  font-size: 11.5px;
  color: var(--muted);
}
.recent-title {
  font-family: var(--serif);
  font-size: 15.5px;
  font-weight: 400;
  color: var(--ink);
}
.recent-arrow {
  font-size: 13px;
  color: var(--muted);
}

/* 5. Bottom Guide */
.hub-footer {
  margin-top: 48px;
  padding: 24px;
  background: var(--bg-soft);
  border-radius: 6px;
  text-align: center;
  font-size: 13.5px;
  color: var(--ink-2);
}
.hub-footer a {
  font-weight: 600;
  color: var(--ink);
  border-bottom: 1px solid var(--ink);
  padding-bottom: 2px;
  margin-left: 6px;
}

@media (max-width: 768px) {
  .hub-wrap { padding: 40px 20px 60px; }
  .tools-strip { grid-template-columns: 1fr; }
  .recent-row { grid-template-columns: 1fr; gap: 4px; }
  .recent-date { display: none; }
}
</style>

<div class="hub-wrap">
  <!-- 1. 담백한 헤더 -->
  <header class="hub-header reveal">
    <p class="hub-meta">DADANOTE · REAL SIDE INCOME ARCHIVE</p>
    <h1>시도하고, <em>검증하고,</em> 기록한다.</h1>
    <p>
      과장된 수익 인증이나 막연한 환상 대신, 직장인의 여건에서 지속 가능한 현실 부수입의 실전 운영법과 검증 데이터를 기록합니다.
    </p>
  </header>

  <!-- 2. 최신 대표 글 (1편 포커스) -->
  {pick && (
    <article class="hub-featured reveal">
      <p class="featured-label">LATEST ISSUE · 최신 실전 가이드</p>
      <a href={`/posts/${pick.id}/`}>
        <h2>{pick.data.title}</h2>
      </a>
      <p>{pick.data.summary}</p>
      <div class="featured-foot">
        <span>{fmtDate(pick.data.date)} · {readMin(pick.body ?? '')}분 소요</span>
        <a href={`/posts/${pick.id}/`} class="featured-link">가이드 전문 읽기 →</a>
      </div>
    </article>
  )}

  <!-- 3. 실전 계산기 도구 2종 -->
  <section class="tools-strip reveal">
    <a href="/tools/4insur/" class="tool-box">
      <div>
        <h4>직장인 4대보험 & 실수령 계산기</h4>
        <p>부수입 2,000만 원 건보료 기준 및 실수령액 산출</p>
      </div>
      <span class="tool-arrow">→</span>
    </a>
    <a href="/tools/growth/" class="tool-box">
      <div>
        <h4>우리아이 성장 백분위 계산기</h4>
        <p>질병관리청 최신 도표 기반 키·몸무게 정밀 백분위</p>
      </div>
      <span class="tool-arrow">→</span>
    </a>
  </section>

  <!-- 4. 최근 발행 기록 (딱 3편만 컴팩트하게) -->
  <section class="recent-section reveal">
    <div class="section-title-bar">
      <h3>최근 발행 기록</h3>
      <a href="/side-income/">Side Income에서 전체 16편 보기 →</a>
    </div>

    <div class="recent-list">
      {recentList.map(post => (
        <a href={`/posts/${post.id}/`} class="recent-row">
          <span class="recent-date">{fmtDate(post.data.date)}</span>
          <span class="recent-title">{post.data.title}</span>
          <span class="recent-arrow">→</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 5. 하단 안내 -->
  <div class="hub-footer reveal">
    플랫폼별 태그 필터(쿠팡, 애드센스, 크몽, 네이버)와 전체 목차는
    <a href="/side-income/">Side Income 전체 보관함</a>에서 확인하실 수 있습니다.
  </div>
</div>
</Layout>
