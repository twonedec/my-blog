---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

// 1. 실제 마크다운 게시물 데이터 불러오기
const allPosts = await getCollection('posts');

// 2. 최신순으로 정렬
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="다다노트">
	<!-- Hero Section -->
	<section class="py-16 md:py-24 flex flex-col items-center text-center">
		<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight mb-6 leading-tight">
			우리가족의 이야기, <br class="md:hidden" />
			<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">다다노트</span>
		</h1>
		<p class="text-lg md:text-xl text-slate-600 max-w-2xl mb-10 leading-relaxed">
			가족 나들이 로그부터 생활 밀착형 재테크, 실사용 IT 기기 리뷰와 코딩 기록까지 소중한 정보를 나눕니다.
		</p>
	</section>

	<!-- Recent Posts Section -->
	<section class="mt-8 md:mt-12">
		<div class="flex items-center justify-between mb-8">
			<h2 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
				최근 게시물
			</h2>
			<a href="/posts" class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors">
				전체보기 &rarr;
			</a>
		</div>

		<!-- Responsive Grid -->
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{posts.length === 0 ? (
				<p class="text-slate-500 py-10 col-span-full text-center">아직 작성된 글이 없습니다. src/content/posts 폴더에 첫 글을 작성해 보세요!</p>
			) : (
				posts.map((post) => (
					<Card 
						title={post.data.title}
						summary={post.data.summary}
						date={new Date(post.data.date).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
						category={post.data.category}
						image={post.data.image}
						href={`/posts/${post.id}`}
					/>
				))
			)}
		</div>
	</section>
</Layout>
